          <rect data-slot="node" x="53.55" y="35.55" width="0.9" height="0.9" />
          <rect data-slot="node" x="35.55" y="35.55" width="0.9" height="0.9" />
          <rect data-slot="node" x="35.55" y="29.55" width="0.9" height="0.9" />
          <rect data-slot="node" x="41.55" y="29.55" width="0.9" height="0.9" />
          <rect data-slot="node" x="41.55" y="11.55" width="0.9" height="0.9" />
          <rect data-slot="node" x="35.55" y="11.55" width="0.9" height="0.9" />
        </g>

        <!-- Z -->
        <g data-slot="letter" data-letter="Z">
          <path
