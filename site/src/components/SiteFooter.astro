---
import { getUiStrings } from '../data/i18n';
import { docHref, getGithubRepoUrl, getLocaleFromUrl, type Locale } from '../lib/url';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const ui = getUiStrings(locale);
const githubUrl = getGithubRepoUrl();
---

<footer data-component="site-footer" data-layout="list">
  <div data-slot="secondary">
    <nav data-component="secondary-nav" aria-label={ui.footerNavAria}>
      <ul>
        <li>
          <a href={docHref('dev', locale)}>
            <span data-slot="box" aria-hidden="true">
              [<span data-slot="fill"></span>]
            </span>
            <span>{ui.footerDevLabel}</span>
          </a>
        </li>
        <li>
          <a href={docHref('troubleshooting', locale)}>
            <span data-slot="box" aria-hidden="true">
              [<span data-slot="fill"></span>]
            </span>
            <span>{ui.footerTroubleshootingLabel}</span>
          </a>
        </li>
        <li>
          <a href={githubUrl} target="_blank" rel="noopener">
            <span data-slot="box" aria-hidden="true">
              [<span data-slot="fill"></span>]
            </span>
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a href={`${githubUrl}/blob/main/Cargo.toml`} target="_blank" rel="noopener">
            <span data-slot="box" aria-hidden="true">
              [<span data-slot="fill"></span>]
            </span>
            <span>MIT License</span>
          </a>
        </li>
        <li>
          <a href={docHref('tui/sessions', locale)} data-component="status" title={ui.footerStatusTitle}>
            <span data-slot="bars" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </span>
            <span data-slot="status-text">{ui.footerStatusText}</span>
          </a>
        </li>
      </ul>
    </nav>

    <div data-component="footer-controls">
      <div data-component="theme-toggle" role="group" aria-label={ui.themeGroupAria}>
        <button
          type="button"
          data-theme-btn="system"
          aria-pressed="false"
          aria-label={ui.themeSystemAria}
          title={ui.themeSystemTitle}
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
            <rect x="2" y="2.75" width="12" height="8.5" />
            <path d="M5.5 14H10.5M8 11.25V14" />
          </svg>
        </button>
        <button
          type="button"
          data-theme-btn="light"
          aria-pressed="false"
          aria-label={ui.themeLightAria}
          title={ui.themeLightTitle}
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
            <circle cx="8" cy="8" r="2.2" />
            <path d="M8 1.5V3.75M8 12.25V14.5M1.5 8H3.75M12.25 8H14.5M3.3 3.3L4.9 4.9M11.1 11.1L12.7 12.7M12.7 3.3L11.1 4.9M4.9 11.1L3.3 12.7" />
          </svg>
        </button>
        <button
          type="button"
          data-theme-btn="dark"
          aria-pressed="false"
          aria-label={ui.themeDarkAria}
          title={ui.themeDarkTitle}
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
            <path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5A5.5 5.5 0 1 0 13.5 9.5Z" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      <div data-component="theme-toggle" role="group" aria-label={ui.markdownExportGroupAria}>
        <button
          type="button"
          data-copy-markdown
          data-state="idle"
          aria-label={ui.copyMarkdownAria}
          title={ui.copyMarkdownTitle}
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
            <rect x="1.75" y="3.25" width="12.5" height="9.5" />
            <path d="M4.25 10V6L6.25 8.2L8.25 6V10M11.25 6V10M9.75 8.5L11.25 10L12.75 8.5" stroke-linejoin="miter" />
          </svg>
        </button>
        <span class="visually-hidden" role="status"></span>
      </div>
    </div>

    <span data-slot="copyright">©2026 Mizar · MIT License</span>
  </div>

  <div data-slot="main">
    <div data-component="wordmark">
      <svg viewBox="-2 4 148 34" preserveAspectRatio="xMinYMin meet" role="img" aria-label="MIZAR">
        <defs>
          <pattern id="mizar-hatch" width="2.2" height="2.2" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="2.2" />
          </pattern>
          <pattern id="mizar-hatch-active" width="2.2" height="2.2" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="2.2" stroke="var(--link)" />
          </pattern>
        </defs>

        <!-- M -->
        <g data-slot="letter" data-letter="M">
          <path
            d="M0 6H6V12H12V18H18V12H24V6H30V36H24V18H18V24H12V18H6V36H0Z"
            data-slot="fill"
            fill="url(#mizar-hatch)"
