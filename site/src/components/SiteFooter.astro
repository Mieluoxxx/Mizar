          <path d="M0 6H6V12H12V18H18V12H24V6H30V36H24V18H18V24H12V18H6V36H0Z" data-slot="outline" />
          <path d="M6 12V18M12 18H18M24 12V18" data-slot="outline" />
          <rect data-slot="node" x="-0.45" y="5.55" width="0.9" height="0.9" />
