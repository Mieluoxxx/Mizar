            fill="url(#mizar-hatch)"
          />
          <path d="M60 6H84V12L68 30H84V36H60V30L76 12H60Z" data-slot="outline" />
          <path d="M76 12H84M60 30H68" data-slot="outline" />
          <rect data-slot="node" x="59.55" y="5.55" width="0.9" height="0.9" />
          <rect data-slot="node" x="83.55" y="5.55" width="0.9" height="0.9" />
          <rect data-slot="node" x="83.55" y="11.55" width="0.9" height="0.9" />
