---
import { getUiStrings } from '../data/i18n';
import { docHref, getLocaleFromUrl, type Locale } from '../lib/url';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const ui = getUiStrings(locale);
---

<div data-component="brand-lockup">
  <a
    data-slot="logo-link"
    href={docHref('intro', locale)}
    aria-label={ui.brandHomeAria}
  >
    <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path d="M4 27V6.8H8.6L15.6 15L18.4 12.1L21.1 14.8L15.6 20.6L8.2 12.2V27H4Z" fill="var(--text-strong)" />
      <path d="M21.5 16.8H25.7V27H21.5V16.8Z" fill="var(--text-strong)" />
      <path d="M23.6 5.6 Q24.416 9.584 28.4 10.4 Q24.416 11.216 23.6 15.2 Q22.784 11.216 18.8 10.4 Q22.784 9.584 23.6 5.6 Z" fill="var(--link)" />
      <path d="M28.6 2.4 Q29.16 3.84 30.6 4.4 Q29.16 4.96 28.6 6.4 Q28.04 4.96 26.6 4.4 Q28.04 3.84 28.6 2.4 Z" fill="var(--text-strong)" />
    </svg>
    <span data-slot="wordmark">{ui.brandWordmark}</span>
  </a>
</div>
