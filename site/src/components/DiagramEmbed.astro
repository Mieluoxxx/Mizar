---
import ConfigPrecedenceDiagram from './diagrams/ConfigPrecedenceDiagram.astro';
import TuiModesDiagram from './diagrams/TuiModesDiagram.astro';
import ToolExposureDiagram from './diagrams/ToolExposureDiagram.astro';
import SessionTraceDiagram from './diagrams/SessionTraceDiagram.astro';
import SecurityMatrixDiagram from './diagrams/SecurityMatrixDiagram.astro';
import CordisArchitectureDiagram from './diagrams/CordisArchitectureDiagram.astro';
import { getLocaleFromUrl, type Locale } from '../lib/url';

interface Props {
  id:
    | 'config-precedence'
    | 'tui-modes'
    | 'tool-exposure'
    | 'session-trace'
    | 'security-matrix'
    | 'cordis-architecture';
  title?: string;
  caption?: string;
  locale?: Locale;
}

const { id, caption } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
---

{id === 'config-precedence' && <ConfigPrecedenceDiagram caption={caption} locale={locale} />}
{id === 'tui-modes' && <TuiModesDiagram caption={caption} locale={locale} />}
{id === 'tool-exposure' && <ToolExposureDiagram caption={caption} locale={locale} />}
{id === 'session-trace' && <SessionTraceDiagram caption={caption} locale={locale} />}
{id === 'security-matrix' && <SecurityMatrixDiagram caption={caption} locale={locale} />}
{id === 'cordis-architecture' && <CordisArchitectureDiagram caption={caption} locale={locale} />}
