---
import DiagramFrame from './DiagramFrame.astro';
import { getLocaleFromUrl, type Locale } from '../../lib/url';

interface Props {
  caption?: string;
  locale?: Locale;
}

const { caption } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const isEn = locale === 'en';
---

<DiagramFrame
  fig="FIG 03"
  title={isEn ? '! vs !! Local Bash Execution & Context Split' : '! 与 !! 本地 Bash 执行与上下文分流'}
  caption={caption}
  locale={locale}
>
  <svg
    viewBox="0 0 840 470"
    width="840"
    height="470"
    role="img"
    aria-label={isEn
      ? 'Mizar ! vs !! local bash execution and routing: both skip approval, run in an isolated process group with Esc tree cleanup and SQLite persistence, while ! enters model context and !! stays isolated from context and compaction'
      : 'Mizar ! 与 !! 本地 Bash 执行流程与分流架构：两者均跳过审批、直连独立进程组、支持 Esc 清理子进程树与 SQLite 持久化，但 ! 进入模型上下文而 !! 彻底隔离于模型与 Compaction'}
  >
    <defs>
      <pattern id="bash-hatch-ok" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-ok)" stroke-width="1" stroke-opacity="0.22" />
      </pattern>
      <pattern id="bash-hatch-muted" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-degraded)" stroke-width="1" stroke-opacity="0.22" />
      </pattern>
      <pattern id="bash-hatch-outage" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="5" stroke="var(--status-outage)" stroke-width="1" stroke-opacity="0.22" />
      </pattern>
      <marker id="bash-arr-ink" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--grey-9)" />
      </marker>
      <marker id="bash-arr-ok" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--status-ok)" />
      </marker>
      <marker id="bash-arr-warn" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--status-degraded)" />
      </marker>
    </defs>

    {/* 第 1 列：输入前缀识别 */}
    <g>
      <rect x="21" y="24" width="172" height="94" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1.35" />
      <rect x="21" y="24" width="172" height="24" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.35" />
      <text x="33" y="40" font-size="11" font-weight="700" fill="var(--callout-tip-ink)">! &lt;cmd&gt;</text>
      <text x="181" y="40" font-size="9.5" text-anchor="end" fill="var(--callout-tip-ink)">CONTEXT</text>
      <text x="33" y="69" font-size="10.5" font-weight="600" fill="var(--grey-11)">BashInputMode::Context</text>
      <text x="33" y="88" font-size="10" fill="var(--grey-9)">! cargo test -p session</text>
      <text x="33" y="106" font-size="9.5" fill="var(--grey-8)">exclude_from_context=false</text>
      <rect x="19" y="22" width="4" height="4" fill="var(--status-ok)" />
    </g>

    <g>
      <rect x="21" y="140" width="172" height="94" fill="var(--grey-2)" stroke="var(--status-degraded)" stroke-width="1.35" />
      <rect x="21" y="140" width="172" height="24" fill="var(--grey-3)" stroke="var(--status-degraded)" stroke-width="1.35" />
      <text x="33" y="156" font-size="11" font-weight="700" fill="var(--callout-caution-ink)">!! &lt;cmd&gt;</text>
      <text x="181" y="156" font-size="9.5" text-anchor="end" fill="var(--callout-caution-ink)">ISOLATED</text>
      <text x="33" y="185" font-size="10.5" font-weight="600" fill="var(--grey-11)">BashInputMode::NoContext</text>
      <text x="33" y="204" font-size="10" fill="var(--grey-9)">!! git status -sb</text>
      <text x="33" y="222" font-size="9.5" fill="var(--grey-8)">exclude_from_context=true</text>
      <rect x="19" y="138" width="4" height="4" fill="var(--status-degraded)" />
    </g>

    {/* 第 1 列到第 2 列汇合线 */}
    <path d="M 193 71 H 208 V 187 H 193" fill="none" stroke="var(--grey-8)" stroke-width="1.2" />
    <line x1="208" y1="129" x2="224" y2="129" stroke="var(--grey-9)" stroke-width="1.3" marker-end="url(#bash-arr-ink)" />

    {/* 第 2 列：共享本地 Shell 执行器 */}
    <g>
      <rect x="227" y="24" width="226" height="210" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="227" y="24" width="226" height="26" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="239" y="41" font-size="11" font-weight="700" fill="var(--grey-11)">{isEn ? 'Local Shell Runner' : '直连本地 Shell 执行引擎'}</text>
      <text x="441" y="41" font-size="9.5" text-anchor="end" fill="var(--grey-8)">SHARED</text>

      <rect x="239" y="60" width="202" height="36" fill="var(--grey-3)" stroke="var(--border)" stroke-width="1" />
      <text x="249" y="76" font-size="10" font-weight="600" fill="var(--grey-11)">{isEn ? 'Bypasses --approve Gate' : '跳过 --approve 审批闸门'}</text>
      <text x="249" y="90" font-size={isEn ? 8.5 : 9} fill="var(--grey-8)">{isEn ? 'Direct RunLocalBash; no pre-execute' : 'RunLocalBash 直连，不走 pre-execute'}</text>

      <rect x="239" y="104" width="202" height="36" fill="var(--grey-3)" stroke="var(--border)" stroke-width="1" />
      <text x="249" y="120" font-size="10" font-weight="600" fill="var(--grey-11)">{isEn ? 'Isolated process_group(0)' : '独立进程组 process_group(0)'}</text>
      <text x="249" y="134" font-size="9" fill="var(--grey-8)">{isEn ? 'Esc sends SIGKILL(-pid) to tree' : 'Esc 发 SIGKILL(-pid) 清理子进程树'}</text>

      <rect x="239" y="148" width="202" height="36" fill="var(--grey-3)" stroke="var(--border)" stroke-width="1" />
      <text x="249" y="164" font-size={isEn ? 10 : 10.5} font-weight="600" fill="var(--grey-11)">{isEn ? '2000-line / 50 KB Tail Cap' : '2000 行 / 50 KB 尾部截断'}</text>
      <text x="249" y="178" font-size={isEn ? 8.5 : 9.5} fill="var(--grey-8)">{isEn ? 'Full output saved to temp_dir/mizar' : '完整输出落盘 temp_dir/mizar'}</text>

      <rect x="239" y="192" width="202" height="32" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1" />
      <text x="340" y="212" font-size={isEn ? 10 : 10.5} font-weight="600" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'Never Auto-Triggers AI Reply' : '不自动触发 AI 回复'}</text>

      <rect x="225" y="22" width="4" height="4" fill="var(--grey-1)" stroke="var(--grey-7)" stroke-width="1" />
      <rect x="451" y="232" width="4" height="4" fill="var(--grey-1)" stroke="var(--grey-7)" stroke-width="1" />
    </g>

    {/* 第 2 列底部共用基座：持久化与交互守卫 */}
    <g>
      <rect x="21" y="254" width="432" height="192" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.2" />
      <rect x="21" y="254" width="432" height="26" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.2" />
      <text x="33" y="271" font-size={isEn ? 10.5 : 11} font-weight="700" fill="var(--grey-11)">{isEn ? 'Shared Lifecycle & SQLite Persistence' : '共同生命周期 & SQLite 持久化基座'}</text>
      <text x="441" y="271" font-size="9.5" text-anchor="end" fill="var(--grey-8)">INVARIANTS</text>

      <rect x="33" y="292" width="198" height="66" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="45" y="313" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? 'First-Class Event Log' : '一等公民事件落盘'}</text>
      <text x="45" y="331" font-size="9.5" fill="var(--grey-9)">{isEn ? 'Persisted as SessionEvent::' : '均写入 SessionEvent::'}</text>
      <text x="45" y="346" font-size="9.5" fill="var(--link)">{isEn ? 'BashExecution for replay' : 'BashExecution 供回放'}</text>

      <rect x="243" y="292" width="198" height="66" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="255" y="313" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? 'Concurrency Guard' : '并发提交守卫'}</text>
      <text x="255" y="331" font-size="9.5" fill="var(--grey-9)">is_busy / is_bash_running</text>
      <text x="255" y="346" font-size="9.5" fill="var(--grey-8)">{isEn ? 'Blocks concurrent local cmds' : '运行期间拦截新本地命令'}</text>

      <rect x="33" y="368" width="198" height="66" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="45" y="389" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? 'Streaming & Expansion' : '流式预览与展开'}</text>
      <text x="45" y="407" font-size={isEn ? 9 : 9.5} fill="var(--grey-9)">{isEn ? '120ms throttled 2-line preview' : '120ms 节流预览最多 2 行'}</text>
      <text x="45" y="422" font-size="9.5" fill="var(--grey-8)">{isEn ? 'Ctrl+O expands full output' : 'Ctrl+O 一键展开全文输出'}</text>

      <rect x="243" y="368" width="198" height="66" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="255" y="389" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? 'Input Mode Boundaries' : '输入态切换边界'}</text>
      <text x="255" y="407" font-size={isEn ? 9 : 9.5} fill="var(--grey-9)">{isEn ? 'Suppresses / slash completion' : '自动屏蔽 / 斜杠补全'}</text>
      <text x="255" y="422" font-size={isEn ? 9 : 9.5} fill="var(--grey-8)">{isEn ? 'Esc exits Bash mode when idle' : '空闲按 Esc 退出 Bash 模式'}</text>
    </g>

    {/* 第 2 列向下连接共享底座 */}
    <line x1="340" y1="234" x2="340" y2="251" stroke="var(--grey-8)" stroke-width="1.2" marker-end="url(#bash-arr-ink)" />

    {/* 核心分叉点：x=453 -> x=474 通道分流到右侧双轨 */}
    <line x1="453" y1="129" x2="474" y2="129" stroke="var(--grey-9)" stroke-width="1.3" />
    <rect x="470" y="125" width="8" height="8" fill="var(--grey-2)" stroke="var(--grey-11)" stroke-width="1.3" />
    <path d="M 474 125 V 114 H 494" fill="none" stroke="var(--status-ok)" stroke-width="1.4" marker-end="url(#bash-arr-ok)" />
    <path d="M 474 133 V 342 H 494" fill="none" stroke="var(--status-degraded)" stroke-width="1.4" marker-end="url(#bash-arr-warn)" />

    {/* 右上轨道：! 载入上下文 */}
    <g>
      <rect x="497" y="24" width="322" height="196" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1.4" />
      <rect x="497" y="24" width="322" height="28" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.4" />
      <rect x="497" y="24" width="322" height="28" fill="url(#bash-hatch-ok)" />
      <rect x="509" y="28" width="212" height="20" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="0.9" />
      <text x="517" y="42" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? '! Track · Enter Model Context' : '! 轨道 · 载入模型上下文'}</text>
      <text x="807" y="42" font-size="9.5" font-weight="700" text-anchor="end" fill="var(--callout-tip-ink)">IN-CONTEXT</text>

      <rect x="513" y="64" width="290" height="38" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="525" y="80" font-size="10.5" font-weight="600" fill="var(--grey-11)">Session::derive_messages()</text>
      <text x="525" y="95" font-size={isEn ? 9 : 9.5} fill="var(--grey-9)">{isEn ? 'Maps to Message::User (cmd, output, exit code)' : '映射为 Message::User（含命令/输出/退出码）'}</text>

      <rect x="513" y="110" width="290" height="38" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="525" y="126" font-size="10" font-weight="600" fill="var(--grey-11)">{isEn ? 'Counted in Context & Compaction' : '计入上下文预算与 Compaction'}</text>
      <text x="525" y="141" font-size="9" fill="var(--grey-9)">{isEn ? 'Tracked by refresh_context_breakdown' : 'refresh_context_breakdown 统计并参与摘要'}</text>

      <rect x="513" y="158" width="290" height="48" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.2" />
      <text x="525" y="178" font-size={isEn ? 10.5 : 11} font-weight="700" fill="var(--callout-tip-ink)">{isEn ? '✓ Visible on Next LLM Turn' : '✓ 下一轮模型请求可见'}</text>
      <text x="525" y="195" font-size="9.5" fill="var(--grey-10)">{isEn ? 'Tagged "· in context" in --resume & /tree' : '--resume 与 /tree 明确标注「· 已入上下文」'}</text>

      <rect x="495" y="22" width="4" height="4" fill="var(--status-ok)" />
      <rect x="817" y="218" width="4" height="4" fill="var(--status-ok)" />
    </g>

    {/* 右下轨道：!! 仅本地审计隔离 */}
    <g>
      <rect x="497" y="244" width="322" height="202" fill="var(--grey-2)" stroke="var(--status-degraded)" stroke-width="1.4" />
      <rect x="497" y="244" width="322" height="28" fill="var(--grey-3)" stroke="var(--status-degraded)" stroke-width="1.4" />
      <rect x="497" y="244" width="322" height="28" fill="url(#bash-hatch-muted)" />
      <rect x="509" y="248" width="218" height="20" fill="var(--grey-2)" stroke="var(--status-degraded)" stroke-width="0.9" />
      <text x="517" y="262" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? '!! Track · Local Audit Only' : '!! 轨道 · 仅本地审计与回放'}</text>
      <text x="807" y="262" font-size="9.5" font-weight="700" text-anchor="end" fill="var(--callout-caution-ink)">NO-CONTEXT</text>

      <rect x="513" y="284" width="290" height="36" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="525" y="300" font-size={isEn ? 10 : 10.5} font-weight="600" fill="var(--grey-11)">{isEn ? 'Kept in TUI, --resume & /tree' : '保留在 TUI 卡片、--resume 与 /tree'}</text>
      <text x="525" y="314" font-size="9.5" fill="var(--grey-9)">{isEn ? 'Tagged "· local only" for history audit' : '明确标注「· 仅本地」，可独立审计命令历史'}</text>

      <rect x="513" y="328" width="290" height="36" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="525" y="344" font-size={isEn ? 9.5 : 10} font-weight="600" fill="var(--grey-11)">{isEn ? 'Skipped by derive_messages() & Compaction' : 'derive_messages() & Compaction 跳过'}</text>
      <text x="525" y="358" font-size="9" fill="var(--grey-9)">{isEn ? 'exclude_from_context=true → 0 tokens' : 'exclude_from_context=true → 0 Token 占用'}</text>

      {/* 上下文防火墙阻断示意 */}
      <rect x="513" y="374" width="136" height="58" fill="var(--grey-1)" stroke="var(--status-degraded)" stroke-width="1" />
      <text x="581" y="397" font-size="10" font-weight="600" text-anchor="middle" fill="var(--grey-11)">BashExecution</text>
      <text x="581" y="415" font-size="9.5" text-anchor="middle" fill="var(--callout-caution-ink)">exclude = true</text>

      <line x1="651" y1="403" x2="674" y2="403" stroke="var(--status-outage)" stroke-width="1.3" stroke-dasharray="3 2" />
      <line x1="676" y1="378" x2="676" y2="428" stroke="var(--status-outage)" stroke-width="2.2" />
      <text x="676" y="438" font-size="8.5" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? 'BARRIER' : '隔离墙'}</text>

      <rect x="688" y="374" width="115" height="58" fill="var(--code-del-tint)" stroke="var(--status-outage)" stroke-width="1.1" stroke-dasharray="3 2" />
      <rect x="688" y="374" width="115" height="58" fill="url(#bash-hatch-outage)" />
      <rect x="696" y="384" width="99" height="38" fill="var(--grey-2)" stroke="var(--status-outage)" stroke-width="0.9" />
      <text x="745" y="400" font-size="10" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? '✕ LLM Blind' : '✕ 模型不可见'}</text>
      <text x="745" y="415" font-size="9" text-anchor="middle" fill="var(--grey-8)">{isEn ? '0 Token Leak' : '零上下文泄露'}</text>

      <rect x="495" y="242" width="4" height="4" fill="var(--status-degraded)" />
      <rect x="817" y="444" width="4" height="4" fill="var(--status-degraded)" />
    </g>
  </svg>
</DiagramFrame>
