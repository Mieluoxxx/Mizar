---
import DiagramFrame from './DiagramFrame.astro';
import { getLocaleFromUrl, type Locale } from '../../lib/url';

interface Props {
  caption?: string;
  locale?: Locale;
}

const { caption } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const isEn = locale === 'en';
---

<DiagramFrame
  fig="FIG 08"
  title={isEn ? '10-Crate Static DAG Architecture & Compile Boundaries' : '10-Crate 静态 DAG 架构与编译隔离红线'}
  caption={caption}
  locale={locale}
>
  <svg
    viewBox="0 0 840 540"
    width="840"
    height="540"
    role="img"
    aria-label={isEn
      ? 'Mizar 10-crate layered architecture and compile-time isolation boundary: 8 host, domain, isolated extension, and base capability crates on the left wired by static MizarRuntime::build DAG; a strict compilation firewall in the center forbidding tokio, reqwest, rquickjs, rusqlite, and tracing; and 2 pure core crates (mizar-tui-ui and mizar-types) on the right'
      : 'Mizar 10 个 Crate 静态分层架构与编译隔离红线：左侧为宿主接入、mizar-core 静态组合根、隔离扩展与基础能力共 8 个运行时 crate；中间为禁止引入 tokio/reqwest/rquickjs/rusqlite/tracing 的编译隔离红线；右侧为受保护的 mizar-tui-ui 与零内部依赖 mizar-types 2 个纯核心 crate'}
  >
    <defs>
      <pattern id="rt-hatch-firewall" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-outage)" stroke-width="1.1" stroke-opacity="0.28" />
      </pattern>
      <pattern id="rt-hatch-core" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--link)" stroke-width="1" stroke-opacity="0.18" />
      </pattern>
      <pattern id="rt-hatch-spine" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-ok)" stroke-width="1" stroke-opacity="0.18" />
      </pattern>
      <marker id="rt-arr-ink" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--grey-9)" />
      </marker>
      <marker id="rt-arr-link" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--link)" />
      </marker>
      <marker id="rt-arr-ok" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--status-ok)" />
      </marker>
    </defs>

    {/* ================= 左侧：运行时与宿主接入栈 (8 Crates) ================= */}

    {/* 第 1 层：终端与跨端宿主层 (2) */}
    <g>
      <rect x="21" y="20" width="514" height="72" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="21" y="20" width="514" height="22" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="33" y="35" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? 'L1 Terminal Adapter & Cross-Surface Host (2 Crates)' : 'L1 终端入口 & 跨端宿主接入层 (2 Crates)'}</text>
      <text x="523" y="35" font-size="9" text-anchor="end" fill="var(--grey-8)">HOST / CLIENT</text>

      <rect x="33" y="49" width="218" height="35" fill="var(--grey-1)" stroke="var(--link)" stroke-width="1.1" />
      <text x="142" y="64" font-size="10" font-weight="700" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'mizar-tui (mizar binary)' : 'mizar-tui (mizar 唯一入口)'}</text>
      <text x="142" y="77" font-size="8.5" text-anchor="middle" fill="var(--grey-8)">{isEn ? 'CLI · exec · Terminal I/O Bridge' : 'CLI · mizar exec · 终端桥接'}</text>

      <line x1="251" y1="66" x2="270" y2="66" stroke="var(--grey-9)" stroke-width="1.2" marker-end="url(#rt-arr-ink)" />

      <rect x="273" y="49" width="250" height="35" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1.1" />
      <text x="398" y="64" font-size="9.8" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-client (Merak-ready)</text>
      <text x="398" y="77" font-size="8.3" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'Shared host runtime · ✕ ratatui / crossterm' : '跨端宿主运行时 · 严禁 ratatui / crossterm'}</text>

      <rect x="19" y="18" width="4" height="4" fill="var(--grey-1)" stroke="var(--grey-7)" stroke-width="1" />
    </g>

    {/* L1 -> L2 */}
    <line x1="278" y1="92" x2="278" y2="104" stroke="var(--status-ok)" stroke-width="1.3" marker-end="url(#rt-arr-ok)" />

    {/* 第 2 层：Agent 领域核与静态组合根 (1 Crate: mizar-core) */}
    <g>
      <rect x="21" y="106" width="514" height="130" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.4" />
      <rect x="21" y="106" width="514" height="130" fill="url(#rt-hatch-spine)" />
      <rect x="21" y="106" width="514" height="22" fill="var(--grey-3)" stroke="var(--status-ok)" stroke-width="1.3" />
      <text x="33" y="121" font-size={isEn ? 9.8 : 10.5} font-weight="700" fill="var(--callout-tip-ink)">
        {isEn
          ? 'L2 Agent Domain & Static Composition Root (1 Crate · mizar-core)'
          : 'L2 Agent 领域核与静态组合根 (1 Crate · mizar-core)'}
      </text>
      <text x="523" y="121" font-size="8.5" text-anchor="end" fill="var(--grey-8)">9 MODULES</text>

      {/* Composition Root top bar */}
      <rect x="33" y="135" width="248" height="28" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1.1" />
      <text x="157" y="153" font-size="9.2" font-weight="700" text-anchor="middle" fill="var(--callout-tip-ink)">
        {isEn ? 'spine: MizarRuntime::build (Static DAG)' : 'spine: MizarRuntime::build 静态 DAG'}
      </text>

      <rect x="287" y="135" width="236" height="28" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1.1" />
      <text x="405" y="153" font-size="9" font-weight="600" text-anchor="middle" fill="var(--grey-11)">
        {isEn ? 'SpinePlugins (AtomicBool · Lazy MCP)' : 'SpinePlugins (原子开关 · MCP 懒启动)'}
      </text>

      {/* Module Row 1 */}
      <rect x="33" y="170" width="118" height="25" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="92" y="186" font-size="9.2" font-weight="700" text-anchor="middle" fill="var(--grey-11)">agent_loop</text>

      <rect x="157" y="170" width="118" height="25" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="216" y="186" font-size="9.2" font-weight="600" text-anchor="middle" fill="var(--grey-11)">system_prompt</text>

      <rect x="281" y="170" width="118" height="25" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="340" y="186" font-size="9.2" font-weight="600" text-anchor="middle" fill="var(--grey-11)">compaction</text>

      <rect x="405" y="170" width="118" height="25" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="464" y="186" font-size="9.2" font-weight="600" text-anchor="middle" fill="var(--grey-11)">instructions</text>

      {/* Module Row 2 */}
      <rect x="33" y="201" width="118" height="25" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="92" y="217" font-size="9.2" font-weight="600" text-anchor="middle" fill="var(--grey-11)">skills</text>

      <rect x="157" y="201" width="118" height="25" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="216" y="217" font-size="9.2" font-weight="600" text-anchor="middle" fill="var(--grey-11)">trajectory</text>

      <rect x="281" y="201" width="118" height="25" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="340" y="217" font-size="9.2" font-weight="600" text-anchor="middle" fill="var(--grey-11)">session_title</text>

      <rect x="405" y="201" width="118" height="25" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="464" y="217" font-size="9.2" font-weight="600" text-anchor="middle" fill="var(--grey-11)">subagent</text>
    </g>

    {/* L2 -> L3 */}
    <line x1="278" y1="236" x2="278" y2="248" stroke="var(--grey-9)" stroke-width="1.2" marker-end="url(#rt-arr-ink)" />

    {/* 第 3 层：重量级隔离扩展层 (2 Crates · Optional Features) */}
    <g>
      <rect x="21" y="250" width="514" height="68" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="21" y="250" width="514" height="22" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="33" y="265" font-size={isEn ? 9.8 : 10.5} font-weight="700" fill="var(--grey-11)">
        {isEn
          ? 'L3 Optional Isolated Extensions (2 Crates · #[cfg(feature)])'
          : 'L3 重量级隔离扩展层 (2 Crates · Cargo Optional Features)'}
      </text>

      <rect x="33" y="278" width="240" height="32" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="153" y="293" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-codemode (rquickjs)</text>
      <text x="153" y="304" font-size="8.3" text-anchor="middle" fill="var(--grey-8)">{isEn ? 'feature = "codemode" · JS sandbox' : 'feature = "codemode" · QuickJS 沙箱'}</text>

      <rect x="283" y="278" width="240" height="32" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="403" y="293" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-mcp (stdio / HTTP)</text>
      <text x="403" y="304" font-size="8.3" text-anchor="middle" fill="var(--grey-8)">{isEn ? 'feature = "mcp" · external tool servers' : 'feature = "mcp" · 外部 MCP 客户端'}</text>
    </g>

    {/* L3 -> L4 */}
    <line x1="278" y1="318" x2="278" y2="330" stroke="var(--grey-9)" stroke-width="1.2" marker-end="url(#rt-arr-ink)" />

    {/* 第 4 层：基础能力层 (3 Crates) */}
    <g>
      <rect x="21" y="332" width="514" height="188" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="21" y="332" width="514" height="22" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="33" y="347" font-size={isEn ? 10 : 10.5} font-weight="700" fill="var(--grey-11)">
        {isEn
          ? 'L4 Base Capabilities Layer (3 Crates · Storage, Tools & LLM)'
          : 'L4 基础能力层 (3 Crates · 存储、工具与模型协议)'}
      </text>

      <rect x="33" y="362" width="490" height="45" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="45" y="381" font-size="10" font-weight="700" fill="var(--grey-11)">mizar-session</text>
      <text x="511" y="381" font-size="8.5" text-anchor="end" fill="var(--link)">feature = "bundled"</text>
      <text x="45" y="397" font-size="9" fill="var(--grey-9)">
        {isEn
          ? 'Append log (Surface/LogOnly) · WAL SQLite (Single-Writer) · FTS5 n-gram · static Direct recall'
          : '只追加会话日志 · WAL SQLite (Single-Writer 线程) · FTS5 索引 · 静态 Direct recall 回溯工具'}
      </text>

      <rect x="33" y="414" width="490" height="45" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="45" y="433" font-size="10" font-weight="700" fill="var(--grey-11)">mizar-tools</text>
      <text x="511" y="433" font-size="8.5" text-anchor="end" fill="var(--grey-8)">ToolExposure</text>
      <text x="45" y="449" font-size="9" fill="var(--grey-9)">
        {isEn
          ? 'ToolRuntime (pre -> execute -> post WaterfallHook) · mutation_queue · coding 6 tools · tool_search'
          : 'ToolRuntime (pre -> execute -> post 管线) · 同路径写串行队列 · 编码 6 工具 · BM25 tool_search'}
      </text>

      <rect x="33" y="466" width="490" height="45" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1" />
      <text x="45" y="485" font-size="10" font-weight="700" fill="var(--grey-11)">mizar-llm</text>
      <text x="511" y="485" font-size="8.5" text-anchor="end" fill="var(--link)">reqwest + SSE</text>
      <text x="45" y="501" font-size="9" fill="var(--grey-9)">
        {isEn
          ? 'LlmRuntime · http client · completions / responses / messages adapters · router · retry · mock'
          : 'LlmRuntime · 共享 HTTP/SSE · completions / responses / messages 三协议适配 · router · retry · mock'}
      </text>

      <rect x="19" y="518" width="4" height="4" fill="var(--grey-1)" stroke="var(--grey-7)" stroke-width="1" />
    </g>

    {/* ================= 中间：编译隔离红线 (Compilation Firewall) ================= */}
    <g>
      <rect x="548" y="20" width="78" height="500" fill="var(--code-del-tint)" stroke="var(--status-outage)" stroke-width="1.8" />
      <rect x="548" y="20" width="78" height="500" fill="url(#rt-hatch-firewall)" />

      {/* 红线顶部标签 */}
      <rect x="553" y="26" width="68" height="36" fill="var(--grey-2)" stroke="var(--status-outage)" stroke-width="1.2" />
      <text x="587" y="42" font-size={isEn ? 9.5 : 10} font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? 'COMPILE' : '编译隔离'}</text>
      <text x="587" y="56" font-size={isEn ? 9.5 : 10} font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? 'BOUNDARY' : '红线'}</text>

      {/* 五项禁令依赖卡片 */}
      <rect x="552" y="138" width="70" height="148" fill="var(--grey-2)" stroke="var(--status-outage)" stroke-width="1.3" />
      <text x="587" y="155" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? 'FORBIDDEN' : '禁止引入'}</text>
      <line x1="558" y1="162" x2="616" y2="162" stroke="var(--status-outage)" stroke-width="0.9" />

      <text x="587" y="180" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ tokio</text>
      <text x="587" y="202" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ reqwest</text>
      <text x="587" y="224" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ rquickjs</text>
      <text x="587" y="246" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ rusqlite</text>
      <text x="587" y="268" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ tracing</text>

      {/* 红线底部说明 */}
      <rect x="552" y="423" width="70" height="86" fill="var(--grey-2)" stroke="var(--status-outage)" stroke-width="1.2" />
      <text x="587" y="444" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? 'NO CROSS' : '严禁越界'}</text>
      <text x="587" y="463" font-size="8.5" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'Async/HTTP' : '异步/HTTP/DB'}</text>
      <text x="587" y="478" font-size="8.5" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'belongs in' : '须上移到'}</text>
      <text x="587" y="493" font-size="8.5" font-weight="600" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'Host layer' : '宿主层'}</text>

      <rect x="546" y="18" width="4" height="4" fill="var(--status-outage)" />
      <rect x="624" y="518" width="4" height="4" fill="var(--status-outage)" />
    </g>

    {/* ================= 单向安全依赖跨线 ================= */}
    {/* mizar-tui -> mizar-tui-ui (y=72) */}
    <line x1="535" y1="72" x2="635" y2="72" stroke="var(--link)" stroke-width="1.5" marker-end="url(#rt-arr-link)" />
    {/* runtime stack -> mizar-types (y=340) */}
    <line x1="535" y1="340" x2="635" y2="340" stroke="var(--link)" stroke-width="1.5" marker-end="url(#rt-arr-link)" />

    {/* ================= 右侧：受保护的 2 个纯核心 Crate ================= */}
    <g>
      {/* 1. mizar-tui-ui */}
      <rect x="639" y="20" width="180" height="114" fill="var(--grey-2)" stroke="var(--link)" stroke-width="1.4" />
      <rect x="639" y="20" width="180" height="24" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1.4" />
      <rect x="639" y="20" width="180" height="24" fill="url(#rt-hatch-core)" />
      <rect x="647" y="23" width="106" height="18" fill="var(--grey-2)" />
      <text x="653" y="36" font-size="10.5" font-weight="700" fill="var(--grey-11)">mizar-tui-ui</text>
      <text x="809" y="36" font-size="8.5" font-weight="700" text-anchor="end" fill="var(--link)">PURE UI</text>
      <text x="651" y="61" font-size={isEn ? 9 : 9.5} fill="var(--grey-10)">{isEn ? 'AppState · Virtual Markdown' : 'AppState · 虚拟化 Markdown'}</text>
      <text x="651" y="79" font-size={isEn ? 8.8 : 9.5} fill="var(--grey-9)">{isEn ? 'TuiFeatures · pi-emphasis' : 'TuiFeatures · pi-emphasis'}</text>
      <text x="651" y="97" font-size={isEn ? 8.8 : 9.5} fill="var(--grey-9)">{isEn ? 'Split · Overlay · Oklab Theme' : '双栏 · Overlay · Oklab 主题'}</text>
      <text x="651" y="120" font-size="9" font-weight="600" fill="var(--link)">{isEn ? 'cargo check -p sub-sec loop' : 'cargo check -p 秒级快检'}</text>
      <rect x="817" y="18" width="4" height="4" fill="var(--link)" />

      {/* 纯核心依赖线 mizar-tui-ui -> mizar-types */}
      <line x1="729" y1="134" x2="729" y2="164" stroke="var(--link)" stroke-width="1.3" marker-end="url(#rt-arr-link)" />

      {/* 2. mizar-types */}
      <rect x="639" y="168" width="180" height="214" fill="var(--grey-2)" stroke="var(--link)" stroke-width="1.4" />
      <rect x="639" y="168" width="180" height="24" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1.4" />
      <rect x="639" y="168" width="180" height="24" fill="url(#rt-hatch-core)" />
      <rect x="647" y="171" width="102" height="18" fill="var(--grey-2)" />
      <text x="653" y="184" font-size="10.5" font-weight="700" fill="var(--grey-11)">mizar-types</text>
      <text x="809" y="184" font-size="8.2" font-weight="700" text-anchor="end" fill="var(--link)">PURE CORE</text>

      <text x="651" y="210" font-size="9.5" font-weight="700" fill="var(--grey-11)">hooks</text>
      <text x="651" y="225" font-size="8.6" fill="var(--grey-9)">HookGuard · SyncEventBus</text>
      <text x="651" y="240" font-size="8.6" fill="var(--grey-9)">WaterfallHook · SerialHook</text>

      <line x1="651" y1="250" x2="807" y2="250" stroke="var(--border)" stroke-width="0.9" />

      <text x="651" y="266" font-size="9.5" font-weight="700" fill="var(--grey-11)">llm &amp; trajectory</text>
      <text x="651" y="281" font-size="8.6" fill="var(--grey-9)">Message · SseParser · cache_audit</text>
      <text x="651" y="296" font-size="8.6" fill="var(--grey-9)">TraceEvent · 3-Lane Timeline</text>

      <line x1="651" y1="306" x2="807" y2="306" stroke="var(--border)" stroke-width="0.9" />

      <text x="651" y="322" font-size="9.5" font-weight="700" fill="var(--grey-11)">client</text>
      <text x="651" y="337" font-size="8.6" fill="var(--grey-9)">HostExtensionFlags · ClientEvent</text>

      <text x="651" y="368" font-size="8.6" font-weight="600" fill="var(--callout-tip-ink)">
        {isEn ? '✓ 0 internal deps · ✕ ratatui' : '✓ 零内部依赖 · ✕ ratatui'}
      </text>

      {/* 右下总结卡：10 Crates 统计与边界 */}
      <rect x="639" y="400" width="180" height="120" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.2" />
      <text x="729" y="422" font-size={isEn ? 9.8 : 10.2} font-weight="700" text-anchor="middle" fill="var(--grey-11)">
        {isEn ? '10-Crate Isolation Summary' : '10-Crate 隔离边界汇总'}
      </text>
