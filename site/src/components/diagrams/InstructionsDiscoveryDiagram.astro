---
import DiagramFrame from './DiagramFrame.astro';
import { getLocaleFromUrl, type Locale } from '../../lib/url';

interface Props {
  caption?: string;
  locale?: Locale;
}

const { caption } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const isEn = locale === 'en';
---

<DiagramFrame
  fig="FIG 05"
  title={isEn ? 'AGENTS.md Tree Discovery & 64 KiB Eviction Order' : 'AGENTS.md 沿目录树发现与 64 KiB 淘汰方向'}
  caption={caption}
  locale={locale}
>
  <svg
    viewBox="0 0 840 500"
    width="840"
    height="500"
    role="img"
    aria-label={isEn
      ? 'Mizar AGENTS.md and CLAUDE.md tree discovery, whitespace-trimmed SHA-256 deduplication, 65,536-byte ancestor-first eviction, and on-demand subdir hot sync'
      : 'Mizar AGENTS.md 与 CLAUDE.md 多层级目录树发现流程、去空白 SHA-256 去重、65,536 字节超预算优先淘汰最宽泛祖先策略与按需子目录热同步'}
  >
    <defs>
      <pattern id="inst-hatch-evict" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-outage)" stroke-width="1" stroke-opacity="0.24" />
      </pattern>
      <pattern id="inst-hatch-keep" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-ok)" stroke-width="1" stroke-opacity="0.20" />
      </pattern>
      <marker id="inst-arr-ink" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--grey-9)" />
      </marker>
      <marker id="inst-arr-link" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--link)" />
      </marker>
      <marker id="inst-arr-ok" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--status-ok)" />
      </marker>
      <marker id="inst-arr-outage" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--status-outage)" />
      </marker>
    </defs>

    {/* 左侧：由宽泛到具体的目录树发现链 */}
    <g>
      <rect x="21" y="20" width="332" height="460" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="21" y="20" width="332" height="26" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="33" y="37" font-size={isEn ? 10.5 : 11} font-weight="700" fill="var(--grey-11)">{isEn ? 'Tree Discovery (Broad → Specific)' : '沿目录树发现链（宽泛 → 具体）'}</text>
      <text x="341" y="37" font-size="9.5" text-anchor="end" fill="var(--grey-8)">SCAN ORDER</text>

      {/* 左侧级联树主干 */}
      <line x1="42" y1="74" x2="42" y2="394" stroke="var(--border-strong)" stroke-width="1.4" />

      {/* 1. 用户全局 */}
      <line x1="42" y1="84" x2="56" y2="84" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="39" y="81" width="6" height="6" fill="var(--grey-2)" stroke="var(--grey-8)" stroke-width="1" />
      <rect x="56" y="58" width="283" height="54" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="3 2" />
      <text x="68" y="77" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? '① User Global (UserGlobal)' : '① 用户全局 (UserGlobal)'}</text>
      <text x="328" y="77" font-size="9" text-anchor="end" fill="var(--grey-8)">{isEn ? 'BROADEST' : '最宽泛'}</text>
      <text x="68" y="96" font-size="9.5" fill="var(--grey-9)">~/.mizar/ (MIZAR_HOME) &amp; ~/.agents/</text>

      {/* 2. .git 项目根 */}
      <line x1="42" y1="154" x2="56" y2="154" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="39" y="151" width="6" height="6" fill="var(--grey-2)" stroke="var(--grey-8)" stroke-width="1" />
      <rect x="56" y="126" width="283" height="54" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="68" y="145" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? '② Git Root (project_root)' : '② .git 项目根 (project_root)'}</text>
      <text x="68" y="164" font-size="9.5" fill="var(--grey-9)">{isEn ? 'Walk up from workspace via markers' : '自 workspace 向上探测 projectRootMarkers'}</text>

      {/* 3. 中间祖先目录 */}
      <line x1="42" y1="224" x2="56" y2="224" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="39" y="221" width="6" height="6" fill="var(--grey-2)" stroke="var(--grey-8)" stroke-width="1" />
      <rect x="56" y="194" width="283" height="54" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="68" y="213" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? '③ Ancestor Dirs (ancestor_chain)' : '③ 中间祖先目录 (ancestor_chain)'}</text>
      <text x="68" y="232" font-size="9.5" fill="var(--grey-9)">{isEn ? 'Collect parent dirs top-down from root' : '沿项目根逐层向下收集各父级目录规则'}</text>

      {/* 4. 当前 cwd */}
      <line x1="42" y1="294" x2="56" y2="294" stroke="var(--link)" stroke-width="1.4" />
      <rect x="39" y="291" width="6" height="6" fill="var(--link)" />
      <rect x="56" y="262" width="283" height="56" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1.2" />
      <text x="68" y="282" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? '④ Workspace (cwd)' : '④ 当前工作区 (cwd / workspace)'}</text>
      <text x="328" y="282" font-size="9" font-weight="700" text-anchor="end" fill="var(--link)">{isEn ? 'PRIMARY' : '核心规则'}</text>
      <text x="68" y="301" font-size="9.5" fill="var(--grey-10)">{isEn ? 'High-weight rules nearest active task' : '高优先级贴近任务上下文的工作区规则'}</text>

      {/* 5. 读写子目录按需触达 */}
      <line x1="42" y1="366" x2="56" y2="366" stroke="var(--status-ok)" stroke-width="1.4" />
      <rect x="39" y="363" width="6" height="6" fill="var(--status-ok)" />
      <rect x="56" y="332" width="283" height="64" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.2" />
      <text x="68" y="351" font-size={isEn ? 10 : 10.5} font-weight="700" fill="var(--callout-tip-ink)">{isEn ? '⑤ Subdirs on Demand (followSubdirs)' : '⑤ 读写子目录按需触达 (followSubdirs)'}</text>
      <text x="68" y="369" font-size="9.5" fill="var(--grey-11)">{isEn ? 'On tools/result: read/write/edit ok' : '订阅 tools/result：read / write / edit 成功'}</text>
      <text x="68" y="384" font-size="9.5" fill="var(--grey-9)">{isEn ? 'Injects subdir rules on the next step' : '命中深层子目录时，于下一步自动补充注入'}</text>

      {/* 单目录候选探测顺序 */}
      <rect x="33" y="408" width="308" height="60" fill="var(--grey-3)" stroke="var(--border)" stroke-width="1" />
      <text x="45" y="427" font-size="10" font-weight="700" fill="var(--grey-11)">{isEn ? 'Per-Dir Probe (candidates → local)' : '单目录候选顺序（candidates → localCandidates）'}</text>
      <text x="45" y="445" font-size="9.5" fill="var(--link)">AGENTS.md → CLAUDE.md</text>
      <text x="45" y="460" font-size="9.5" fill="var(--grey-9)">→ AGENTS.local.md → CLAUDE.local.md</text>

      <rect x="19" y="18" width="4" height="4" fill="var(--grey-1)" stroke="var(--grey-7)" stroke-width="1" />
    </g>

    {/* 左 -> 中连接线 */}
    <line x1="353" y1="196" x2="370" y2="196" stroke="var(--grey-9)" stroke-width="1.3" marker-end="url(#inst-arr-ink)" />

    {/* 中列：大小过滤与 SHA-256 去重 */}
    <g>
      <rect x="373" y="20" width="162" height="324" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="373" y="20" width="162" height="26" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="385" y="37" font-size="11" font-weight="700" fill="var(--grey-11)">{isEn ? 'Filter & Dedup' : '过滤与去重管道'}</text>

      <rect x="385" y="62" width="138" height="96" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="454" y="83" font-size="10.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">{isEn ? '1 MiB File Cap' : '1 MiB 源文件上限'}</text>
      <text x="454" y="101" font-size="9.5" text-anchor="middle" fill="var(--link)">maxSourceBytes</text>
      <text x="454" y="119" font-size={isEn ? 9 : 9.5} text-anchor="middle" fill="var(--grey-9)">{isEn ? '> 1 MiB skipped + warn' : '> 1 MiB 跳过并告警'}</text>
      <text x="454" y="136" font-size={isEn ? 9 : 9.5} text-anchor="middle" fill="var(--grey-8)">{isEn ? 'Strip BOM / empty files' : '剥离 UTF-8 BOM / 空文件'}</text>

      <line x1="454" y1="158" x2="454" y2="178" stroke="var(--grey-9)" stroke-width="1.2" marker-end="url(#inst-arr-ink)" />

      <rect x="385" y="182" width="138" height="146" fill="var(--grey-1)" stroke="var(--link)" stroke-width="1.1" />
      <text x="454" y="203" font-size="10.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'Trimmed SHA-256' : '去空白 SHA-256'}</text>
      <text x="454" y="222" font-size="9.5" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'Canonical path dedup' : '规范路径 canonical 去重'}</text>
      <text x="454" y="241" font-size="9.5" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'Hash trim() content' : '计算 trim() 后摘要'}</text>
      <rect x="397" y="256" width="114" height="58" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="0.9" />
      <text x="454" y="275" font-size={isEn ? 9 : 9.5} font-weight="600" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'Same hash → dedup' : '同组一致 → 去重'}</text>
      <text x="454" y="293" font-size={isEn ? 9 : 9.5} text-anchor="middle" fill="var(--grey-9)">{isEn ? 'Diff hash → keep' : '内容不同 → 并存保留'}</text>
    </g>

    {/* 中 -> 右连接线 */}
    <line x1="535" y1="196" x2="552" y2="196" stroke="var(--link)" stroke-width="1.4" marker-end="url(#inst-arr-link)" />

    {/* 右列：65,536 B 预算条与淘汰方向 */}
    <g>
      <rect x="555" y="20" width="264" height="324" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="555" y="20" width="264" height="26" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="567" y="37" font-size="11" font-weight="700" fill="var(--grey-11)">{isEn ? '65,536 B (64 KiB) Budget' : '65,536 B (64 KiB) 预算裁切'}</text>

      {/* 淘汰区域（超出 64 KiB 红线之上） */}
      <rect x="567" y="60" width="144" height="44" fill="var(--code-del-tint)" stroke="var(--status-outage)" stroke-width="1" stroke-dasharray="3 2" />
      <rect x="567" y="60" width="144" height="44" fill="url(#inst-hatch-evict)" />
      <rect x="574" y="66" width="130" height="32" fill="var(--grey-2)" opacity="0.92" />
      <text x="639" y="80" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? '① Global [Omitted]' : '① 全局 [Omitted]'}</text>
      <text x="639" y="93" font-size="8.5" text-anchor="middle" fill="var(--grey-8)">~/.mizar/AGENTS.md</text>

      <rect x="567" y="109" width="144" height="44" fill="var(--code-del-tint)" stroke="var(--status-outage)" stroke-width="1" stroke-dasharray="3 2" />
      <rect x="567" y="109" width="144" height="44" fill="url(#inst-hatch-evict)" />
      <rect x="574" y="115" width="130" height="32" fill="var(--grey-2)" opacity="0.92" />
      <text x="639" y="129" font-size={isEn ? 9 : 9.5} font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? '②③ Ancestor [Omit]' : '②③ 祖先 [Omitted]'}</text>
      <text x="639" y="142" font-size="8.5" text-anchor="middle" fill="var(--grey-8)">{isEn ? 'git root / parent' : '.git 根 / 父级规则'}</text>

      {/* 淘汰方向箭头标注 */}
      <line x1="726" y1="152" x2="726" y2="66" stroke="var(--status-outage)" stroke-width="1.6" marker-end="url(#inst-arr-outage)" />
      <text x="736" y="88" font-size="9.5" font-weight="700" fill="var(--callout-danger-ink)">{isEn ? 'Evict' : '优先淘汰'}</text>
      <text x="736" y="104" font-size="9.5" font-weight="700" fill="var(--callout-danger-ink)">{isEn ? 'Broadest' : '最宽泛祖先'}</text>
      <text x="736" y="122" font-size="8.5" fill="var(--grey-8)">drop_count++</text>
      <text x="736" y="136" font-size="8.5" fill="var(--grey-8)">{isEn ? '+ omit note' : '写省略提示条'}</text>

      {/* 64 KiB 红线 */}
      <line x1="563" y1="164" x2="811" y2="164" stroke="var(--status-outage)" stroke-width="1.8" />
      <rect x="582" y="154" width="154" height="19" fill="var(--grey-1)" stroke="var(--status-outage)" stroke-width="1" />
      <text x="659" y="167" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">maxBytes = 65,536 B</text>

      {/* 保留区域（64 KiB 之内） */}
      <rect x="567" y="180" width="144" height="48" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1.2" />
      <text x="639" y="199" font-size="10" font-weight="700" text-anchor="middle" fill="var(--grey-11)">④ cwd/AGENTS.md</text>
      <text x="639" y="216" font-size="9" text-anchor="middle" fill="var(--link)">{isEn ? '✓ Kept (Primary)' : '✓ 保留（高权重）'}</text>

      <rect x="567" y="234" width="144" height="48" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.2" />
      <text x="639" y="253" font-size="10" font-weight="700" text-anchor="middle" fill="var(--callout-tip-ink)">⑤ subdir/AGENTS.md</text>
      <text x="639" y="270" font-size="9" text-anchor="middle" fill="var(--grey-11)">{isEn ? '✓ Nearest Priority' : '✓ 优先保住近目录'}</text>

      {/* 保留方向标注 */}
      <line x1="726" y1="184" x2="726" y2="278" stroke="var(--status-ok)" stroke-width="1.6" marker-end="url(#inst-arr-ok)" />
      <text x="736" y="212" font-size="9.5" font-weight="700" fill="var(--callout-tip-ink)">{isEn ? 'Preserve' : '全力保住'}</text>
      <text x="736" y="228" font-size="9.5" font-weight="700" fill="var(--callout-tip-ink)">{isEn ? 'Nearest' : '近目录规则'}</text>
      <text x="736" y="246" font-size="8.5" fill="var(--grey-8)">{isEn ? 'Closest to' : '最贴近当前'}</text>
      <text x="736" y="260" font-size="8.5" fill="var(--grey-8)">{isEn ? 'active file' : '读写文件位置'}</text>

      {/* 单文件超限二分截断 */}
      <rect x="567" y="294" width="240" height="38" fill="var(--grey-3)" stroke="var(--border)" stroke-width="1" />
      <text x="687" y="310" font-size={isEn ? 9 : 9.5} font-weight="600" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'If 1 final file still exceeds cap' : '若仅剩最后 1 个文件仍超预算'}</text>
      <text x="687" y="325" font-size="9" text-anchor="middle" fill="var(--grey-8)">{isEn ? '→ Binary-search UTF-8 safe trim' : '→ 执行 UTF-8 边界安全二分截断'}</text>

      <rect x="817" y="18" width="4" height="4" fill="var(--grey-1)" stroke="var(--grey-7)" stroke-width="1" />
    </g>

    {/* 右列向下注入盒子 */}
    <line x1="687" y1="344" x2="687" y2="361" stroke="var(--status-ok)" stroke-width="1.4" marker-end="url(#inst-arr-ok)" />

    {/* 底部右侧：ContextNotice 注入与热同步 */}
    <g>
      <rect x="373" y="364" width="446" height="116" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1.35" />
      <rect x="373" y="364" width="446" height="26" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.35" />
      <text x="385" y="381" font-size={isEn ? 10 : 11} font-weight="700" fill="var(--grey-11)">{isEn ? 'agent/pre-step Injection & Hot Sync (No inject)' : 'agent/pre-step 注入与热同步（零工具 · 无 inject）'}</text>
      <text x="807" y="381" font-size="9.5" font-weight="700" text-anchor="end" fill="var(--callout-tip-ink)">HOT SYNC</text>

      <rect x="385" y="400" width="136" height="68" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="453" y="419" font-size="10" font-weight="700" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'Baseline Inject' : '基线注入'}</text>
      <text x="453" y="436" font-size="9" text-anchor="middle" fill="var(--grey-9)">&lt;system-reminder&gt;</text>
      <text x="453" y="452" font-size="9" text-anchor="middle" fill="var(--link)">{isEn ? 'ContextNotice logged' : 'ContextNotice 入日志'}</text>

      <rect x="529" y="400" width="136" height="68" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="597" y="419" font-size="10" font-weight="700" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'FS Change Watch' : '文件变更感知'}</text>
      <text x="597" y="436" font-size="9" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'FsFingerprint diff' : 'FsFingerprint 校验'}</text>
      <text x="597" y="452" font-size="9" text-anchor="middle" fill="var(--callout-tip-ink)">Added/Updated/Removed</text>

      <rect x="673" y="400" width="134" height="68" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="740" y="419" font-size="10" font-weight="700" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'Compact Self-Heal' : 'Compaction 自愈'}</text>
      <text x="740" y="436" font-size={isEn ? 8.5 : 9} text-anchor="middle" fill="var(--grey-9)">{isEn ? 'If old baseline pruned' : '旧基线被压缩折出后'}</text>
      <text x="740" y="452" font-size={isEn ? 8.5 : 9} text-anchor="middle" fill="var(--grey-8)">{isEn ? 'Rebuilds on next step' : '下一步自动重建基线'}</text>

      <rect x="817" y="478" width="4" height="4" fill="var(--status-ok)" />
    </g>
  </svg>
</DiagramFrame>
