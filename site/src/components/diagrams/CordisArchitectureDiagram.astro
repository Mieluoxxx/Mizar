---
import DiagramFrame from './DiagramFrame.astro';
import { getLocaleFromUrl, type Locale } from '../../lib/url';

interface Props {
  caption?: string;
  locale?: Locale;
}

const { caption } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const isEn = locale === 'en';
---

<DiagramFrame
  fig="FIG 06"
  title={isEn ? 'Cordis 33-Crate Architecture & Pure Core Boundaries' : 'Cordis 33-Crate 分层架构与编译隔离红线'}
  caption={caption}
  locale={locale}
>
  <svg
    viewBox="0 0 840 600"
    width="840"
    height="600"
    role="img"
    aria-label={isEn
      ? 'Mizar 33-crate layered architecture and compile-time isolation boundary: 29 runtime/plugin crates on the left from host and mizar-client down to cordis microkernel, a strict dependency firewall in the center forbidding tokio/cordis/reqwest/rquickjs/rusqlite and terminal libs on mizar-client*, and 4 pure core crates on the right'
      : 'Mizar 33 个 Crate 分层架构与编译隔离红线：左侧为宿主与跨端运行时、编排观测、工具/记忆插件、核心服务、HTTP 协议栈与底层 cordis 微内核共 29 个 crate；中间为禁止引入重型运行时的编译隔离红线；右侧为受保护的 4 个纯核心 crate'}
  >
    <defs>
      <pattern id="cord-hatch-firewall" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-outage)" stroke-width="1.1" stroke-opacity="0.28" />
      </pattern>
      <pattern id="cord-hatch-core" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--link)" stroke-width="1" stroke-opacity="0.18" />
      </pattern>
      <pattern id="cord-hatch-spine" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-ok)" stroke-width="1" stroke-opacity="0.18" />
      </pattern>
      <marker id="cord-arr-ink" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--grey-9)" />
      </marker>
      <marker id="cord-arr-link" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--link)" />
      </marker>
      <marker id="cord-arr-ok" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--status-ok)" />
      </marker>
    </defs>

    {/* ================= 左侧：运行时与插件栈 (29 Crates) ================= */}

    {/* 第 1 层：宿主、跨端运行时与装配层 (3) */}
    <g>
      <rect x="21" y="20" width="514" height="72" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="21" y="20" width="514" height="22" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="33" y="35" font-size={isEn ? 9.8 : 10.5} font-weight="700" fill="var(--grey-11)">{isEn ? 'L1 Host, Cross-End Client & Spine (3 Crates)' : 'L1 终端宿主、跨端运行时 & 装配层 (3 Crates)'}</text>
      <text x="523" y="35" font-size="9" text-anchor="end" fill="var(--grey-8)">HOST / SPINE</text>

      <rect x="31" y="49" width="146" height="35" fill="var(--grey-1)" stroke="var(--link)" stroke-width="1.1" />
      <text x="104" y="64" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-tui</text>
      <text x="104" y="77" font-size="8" text-anchor="middle" fill="var(--grey-8)">{isEn ? 'CLI · exec · Terminal IO' : 'CLI · exec · 终端桥接'}</text>

      <line x1="177" y1="66" x2="189" y2="66" stroke="var(--grey-9)" stroke-width="1.2" marker-end="url(#cord-arr-ink)" />

      <rect x="192" y="49" width="154" height="35" fill="var(--grey-1)" stroke="var(--link)" stroke-width="1.1" />
      <text x="269" y="64" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-client</text>
      <text x="269" y="77" font-size="7.8" text-anchor="middle" fill="var(--grey-8)">{isEn ? 'Zero TUI deps (Merak)' : '零终端依赖 (Merak 直嵌)'}</text>

      <line x1="346" y1="66" x2="358" y2="66" stroke="var(--grey-9)" stroke-width="1.2" marker-end="url(#cord-arr-ink)" />

      <rect x="361" y="49" width="164" height="35" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1.1" />
      <text x="443" y="64" font-size="9.2" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-agent-spine</text>
      <text x="443" y="77" font-size="7.8" text-anchor="middle" fill="var(--grey-8)">"spinePlugins" · 7 features</text>

      <rect x="19" y="18" width="4" height="4" fill="var(--grey-1)" stroke="var(--grey-7)" stroke-width="1" />
    </g>

    {/* L1 -> L2 */}
    <line x1="278" y1="92" x2="278" y2="104" stroke="var(--grey-9)" stroke-width="1.2" marker-end="url(#cord-arr-ink)" />

    {/* 第 2 层：编排、观测与持久化层 (4) */}
    <g>
      <rect x="21" y="106" width="514" height="66" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="21" y="106" width="514" height="22" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="33" y="121" font-size={isEn ? 10 : 10.5} font-weight="700" fill="var(--grey-11)">{isEn ? 'L2 Agent Loop, Trace, Storage & Title (4 Crates)' : 'L2 Agent 编排、观测、存储与标题层 (4 Crates)'}</text>

      <rect x="31" y="135" width="118" height="29" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="90" y="148" font-size="9" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-agent-loop</text>
      <text x="90" y="159" font-size="8" text-anchor="middle" fill="var(--link)">provide "agentLoop"</text>

      <rect x="155" y="135" width="120" height="29" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="215" y="148" font-size="9" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-trajectory</text>
      <text x="215" y="159" font-size="7.8" text-anchor="middle" fill="var(--grey-8)">Trace + RepeatGuard</text>

      <rect x="281" y="135" width="128" height="29" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="345" y="148" font-size="8.8" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-session-sqlite</text>
      <text x="345" y="159" font-size="7.8" text-anchor="middle" fill="var(--grey-8)">WAL · FTS5 · BUSY</text>

      <rect x="415" y="135" width="110" height="29" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="470" y="148" font-size="8.8" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-session-title</text>
      <text x="470" y="159" font-size="7.8" text-anchor="middle" fill="var(--grey-8)">"sessionTitle"</text>
    </g>

    {/* L2 -> L3 */}
    <line x1="278" y1="172" x2="278" y2="184" stroke="var(--grey-9)" stroke-width="1.2" marker-end="url(#cord-arr-ink)" />

    {/* 第 3 层：工具、上下文压缩与记忆插件层 (10) */}
    <g>
      <rect x="21" y="186" width="514" height="145" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="21" y="186" width="514" height="22" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="33" y="201" font-size={isEn ? 9.5 : 10.5} font-weight="700" fill="var(--grey-11)">
        {isEn
          ? 'L3 Tool, Compaction & Context Plugins (10 Crates · optional via spinePlugins)'
          : 'L3 工具、压缩与情景回溯插件层 (10 Crates · 由 spinePlugins 热启停)'}
      </text>

      {/* Row 1 */}
      <rect x="33" y="214" width="124" height="24" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="95" y="230" font-size="9.5" font-weight="600" text-anchor="middle" fill="var(--grey-11)">mizar-tools-coding</text>

      <rect x="164" y="214" width="118" height="24" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="223" y="230" font-size="9.5" font-weight="600" text-anchor="middle" fill="var(--grey-11)">mizar-tool-search</text>

      <rect x="289" y="214" width="126" height="24" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1" />
      <text x="352" y="230" font-size="9" font-weight="600" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'mizar-codemode (on)' : 'mizar-codemode (常驻)'}</text>

      <rect x="422" y="214" width="101" height="24" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="472" y="230" font-size="9.5" font-weight="600" text-anchor="middle" fill="var(--grey-11)">mizar-mcp</text>

      {/* Row 2 */}
      <rect x="33" y="243" width="88" height="24" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="77" y="259" font-size="9.2" font-weight="600" text-anchor="middle" fill="var(--grey-11)">mizar-skills</text>

      <rect x="127" y="243" width="90" height="24" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="172" y="259" font-size="9" text-anchor="middle" fill="var(--grey-9)">mizar-tool-fs</text>

      <rect x="223" y="243" width="94" height="24" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="270" y="259" font-size="9" text-anchor="middle" fill="var(--grey-9)">mizar-tool-time</text>

      <rect x="323" y="243" width="200" height="24" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1" />
      <text x="423" y="259" font-size="8.2" font-weight="600" text-anchor="middle" fill="var(--callout-tip-ink)">mizar-instructions (inject: systemPrompt)</text>

      {/* Row 3: Compaction & Recall */}
      <rect x="33" y="272" width="242" height="24" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1" />
      <text x="154" y="288" font-size="8.8" font-weight="600" text-anchor="middle" fill="var(--grey-11)">
        {isEn ? 'mizar-compaction (B-5 + Tail Prune)' : 'mizar-compaction (B-5 压缩 & 尾部剪枝)'}
      </text>

      <rect x="282" y="272" width="241" height="24" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1" />
      <text x="402" y="288" font-size="8.8" font-weight="600" text-anchor="middle" fill="var(--grey-11)">
        {isEn ? 'mizar-recall (Direct · single recall · FTS5)' : 'mizar-recall (Direct · 单 recall · FTS5)'}
      </text>

      {/* Waterfall 管线条 */}
      <rect x="33" y="301" width="490" height="22" fill="var(--grey-3)" stroke="var(--border)" stroke-width="1" />
      <text x="278" y="316" font-size={isEn ? 9 : 9.5} font-weight="600" text-anchor="middle" fill="var(--grey-10)">
        {isEn
          ? '3-Stage Tool Waterfall: tools/pre-execute ──▶ tools/execute ──▶ tools/post-execute'
          : '工具三段 Waterfall: tools/pre-execute  ──▶  tools/execute  ──▶  tools/post-execute'}
      </text>
    </g>

    {/* L3 -> L4 */}
    <line x1="278" y1="331" x2="278" y2="343" stroke="var(--grey-9)" stroke-width="1.2" marker-end="url(#cord-arr-ink)" />

    {/* 第 4 层：基础服务与 LLM 栈 (11) */}
    <g>
      <rect x="21" y="345" width="514" height="122" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.3" />
      <rect x="21" y="345" width="514" height="22" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.3" />
      <text x="33" y="360" font-size={isEn ? 10 : 10.5} font-weight="700" fill="var(--grey-11)">{isEn ? 'L4 Core Services & HTTP / Protocol Stack (4 + 7 = 11 Crates)' : 'L4 核心基础服务 & HTTP / 协议路由栈 (4 + 7 = 11 Crates)'}</text>

      {/* 4 Core Services */}
      <rect x="33" y="373" width="114" height="26" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1" />
      <text x="90" y="390" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-llm ("llm")</text>

      <rect x="154" y="373" width="124" height="26" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="216" y="390" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-session</text>

      <rect x="285" y="373" width="126" height="26" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="348" y="390" font-size="9" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-system-prompt</text>

      <rect x="418" y="373" width="105" height="26" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="470" y="390" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">mizar-tools</text>

      {/* Router & HTTP & Retry */}
      <rect x="33" y="406" width="186" height="24" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="126" y="422" font-size="9" font-weight="600" text-anchor="middle" fill="var(--grey-11)">mizar-llm-router ("llmRouter")</text>

      <rect x="226" y="406" width="158" height="24" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="305" y="422" font-size="9" font-weight="600" text-anchor="middle" fill="var(--grey-11)">mizar-llm-http (reqwest)</text>

      <rect x="391" y="406" width="132" height="24" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="457" y="422" font-size="9" font-weight="600" text-anchor="middle" fill="var(--grey-11)">mizar-llm-retry</text>

      {/* 4 Protocol Adapters */}
      <rect x="33" y="436" width="136" height="23" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="101" y="451" font-size="9" text-anchor="middle" fill="var(--grey-10)">mizar-llm-completions</text>

      <rect x="176" y="436" width="124" height="23" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="238" y="451" font-size="9" text-anchor="middle" fill="var(--grey-10)">mizar-llm-responses</text>

      <rect x="307" y="436" width="118" height="23" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="366" y="451" font-size="9" text-anchor="middle" fill="var(--grey-10)">mizar-llm-messages</text>

      <rect x="432" y="436" width="91" height="23" fill="var(--grey-1)" stroke="var(--border)" stroke-width="1" />
      <text x="477" y="451" font-size="9" text-anchor="middle" fill="var(--grey-10)">mizar-llm-mock</text>
    </g>

    {/* L4 -> L5 */}
    <line x1="278" y1="467" x2="278" y2="480" stroke="var(--status-ok)" stroke-width="1.3" marker-end="url(#cord-arr-ok)" />

    {/* 第 5 层：cordis 微内核 (1) */}
    <g>
      <rect x="21" y="483" width="514" height="84" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.4" />
      <rect x="21" y="483" width="514" height="84" fill="url(#cord-hatch-spine)" />
      <rect x="21" y="483" width="514" height="22" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1.3" />
      <text x="33" y="498" font-size={isEn ? 9.5 : 10.5} font-weight="700" fill="var(--callout-tip-ink)">
        {isEn
          ? 'L5 cordis Kernel (1 Crate · Context Tree / Fiber FSM / inject & provide)'
          : 'L5 cordis 微内核 (1 Crate · Context 树 / Fiber 状态机 / inject & provide)'}
      </text>

      <rect x="33" y="513" width="256" height="44" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1" />
      <text x="161" y="531" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">{isEn ? '5 Event Dispatch Modes' : '5 种事件分发模式'}</text>
      <text x="161" y="547" font-size="9" text-anchor="middle" fill="var(--grey-9)">emit · parallel · serial · bail · waterfall</text>

      <rect x="299" y="513" width="224" height="44" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1" />
      <text x="411" y="531" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--callout-tip-ink)">{isEn ? 'ctx.effect("id", ...) Invariant' : 'ctx.effect("id", ...) 不变量'}</text>
      <text x="411" y="547" font-size="9" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'LIFO cleanup on Fiber unload' : 'Fiber 卸载时按创建逆序自动清理'}</text>

      <rect x="19" y="565" width="4" height="4" fill="var(--status-ok)" />
    </g>

    {/* ================= 中间：编译隔离红线 (Compilation Firewall) ================= */}
    <g>
      <rect x="548" y="20" width="78" height="547" fill="var(--code-del-tint)" stroke="var(--status-outage)" stroke-width="1.8" />
      <rect x="548" y="20" width="78" height="547" fill="url(#cord-hatch-firewall)" />

      {/* 红线顶部标签 */}
      <rect x="553" y="26" width="68" height="36" fill="var(--grey-2)" stroke="var(--status-outage)" stroke-width="1.2" />
      <text x="587" y="42" font-size={isEn ? 9.5 : 10} font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? 'COMPILE' : '编译隔离'}</text>
      <text x="587" y="56" font-size={isEn ? 9.5 : 10} font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? 'BOUNDARY' : '红线'}</text>

      {/* 五项禁令依赖卡片 */}
      <rect x="552" y="170" width="70" height="174" fill="var(--grey-2)" stroke="var(--status-outage)" stroke-width="1.3" />
      <text x="587" y="187" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? 'FORBIDDEN' : '禁止引入'}</text>
      <line x1="558" y1="194" x2="616" y2="194" stroke="var(--status-outage)" stroke-width="0.9" />

      <text x="587" y="212" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ tokio</text>
      <text x="587" y="233" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ cordis</text>
      <text x="587" y="254" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ reqwest</text>
      <text x="587" y="275" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ rquickjs</text>
      <text x="587" y="296" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">✕ rusqlite</text>
      <line x1="558" y1="306" x2="616" y2="306" stroke="var(--status-outage)" stroke-width="0.7" stroke-dasharray="2 2" />
      <text x="587" y="321" font-size="7.8" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">✕ ratatui*</text>
      <text x="587" y="335" font-size="7.5" text-anchor="middle" fill="var(--grey-8)">(client*)</text>

      {/* 红线底部说明 */}
      <rect x="552" y="468" width="70" height="86" fill="var(--grey-2)" stroke="var(--status-outage)" stroke-width="1.2" />
      <text x="587" y="489" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? 'NO CROSS' : '严禁越界'}</text>
      <text x="587" y="508" font-size="8.5" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'Async/HTTP' : '异步/HTTP/DB'}</text>
      <text x="587" y="523" font-size="8.5" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'belongs in' : '须上移到'}</text>
      <text x="587" y="538" font-size="8.5" font-weight="600" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'Host layer' : '宿主层'}</text>

      <rect x="546" y="18" width="4" height="4" fill="var(--status-outage)" />
      <rect x="624" y="565" width="4" height="4" fill="var(--status-outage)" />
    </g>

    {/* ================= 单向安全依赖跨线 ================= */}
    {/* mizar-client -> mizar-client-core */}
    <line x1="535" y1="56" x2="635" y2="56" stroke="var(--link)" stroke-width="1.5" marker-end="url(#cord-arr-link)" />
    {/* mizar-tui -> mizar-tui-ui */}
    <path d="M 535 76 H 544 V 148 H 635" fill="none" stroke="var(--link)" stroke-width="1.5" marker-end="url(#cord-arr-link)" />
    {/* mizar-trajectory -> mizar-trajectory-core */}
    <path d="M 535 152 H 540 V 242 H 635" fill="none" stroke="var(--link)" stroke-width="1.5" marker-end="url(#cord-arr-link)" />
