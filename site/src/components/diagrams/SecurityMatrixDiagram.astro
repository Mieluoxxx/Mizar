---
import DiagramFrame from './DiagramFrame.astro';
import { getLocaleFromUrl, type Locale } from '../../lib/url';

interface Props {
  caption?: string;
  locale?: Locale;
}

const { caption } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const isEn = locale === 'en';
---

<DiagramFrame
  fig="FIG 07"
  title={isEn ? 'Security 2×2 Matrix (Path Scope × Approval)' : '安全边界 2×2 正交矩阵（路径限制 × 工具审批）'}
  caption={caption}
  locale={locale}
>
  <svg
    viewBox="0 0 840 490"
    width="840"
    height="490"
    role="img"
    aria-label={isEn
      ? 'Mizar security 2x2 matrix: horizontal axis restrictToWorkspace constrains file tools only (not bash); vertical axis --approve and /approval ask intercept all non-readonly tools, contrasting default access with recommended defense-in-depth'
      : 'Mizar 安全边界 2×2 正交矩阵：横轴 restrictToWorkspace 仅约束文件工具不约束 bash，纵轴 --approve 与 /approval ask 拦截所有非只读工具，突出显示危险默认区与生产推荐防线'}
  >
    <defs>
      <pattern id="sec-hatch-danger" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-outage)" stroke-width="1" stroke-opacity="0.22" />
      </pattern>
      <pattern id="sec-hatch-warn" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-degraded)" stroke-width="1" stroke-opacity="0.22" />
      </pattern>
      <pattern id="sec-hatch-safe" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-ok)" stroke-width="1" stroke-opacity="0.22" />
      </pattern>
    </defs>

    {/* 左上角正交坐标头 */}
    <g>
      <rect x="21" y="20" width="134" height="56" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.2" />
      <line x1="21" y1="20" x2="155" y2="76" stroke="var(--border-strong)" stroke-width="1" />
      <text x="147" y="38" font-size="9.5" font-weight="700" text-anchor="end" fill="var(--grey-11)">{isEn ? 'Scope →' : '路径限制 →'}</text>
      <text x="29" y="66" font-size="9.5" font-weight="700" fill="var(--grey-11)">{isEn ? '↓ Approval' : '↓ 审批闸门'}</text>
    </g>

    {/* 横轴表头 */}
    <g>
      <rect x="165" y="20" width="320" height="56" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.2" />
      <text x="325" y="41" font-size={isEn ? 11 : 11.5} font-weight="700" text-anchor="middle" fill="var(--grey-11)">{isEn ? 'restrictToWorkspace: false (Default)' : 'restrictToWorkspace: false (默认)'}</text>
      <text x="325" y="61" font-size={isEn ? 9.5 : 10} text-anchor="middle" fill="var(--grey-8)">{isEn ? 'read/write/edit/grep/find can access outside repo' : 'read / write / edit / grep / find 可跨工作区'}</text>

      <rect x="499" y="20" width="320" height="56" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.2" />
      <text x="659" y="41" font-size="11.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">restrictToWorkspace: true</text>
      <text x="659" y="61" font-size={isEn ? 9.5 : 10} text-anchor="middle" fill="var(--callout-caution-ink)">{isEn ? 'File tools only · ⚠️ Does NOT restrict bash!' : '仅约束文件工具 · ⚠️ 不约束 bash！'}</text>
    </g>

    {/* 纵轴表头 */}
    <g>
      <rect x="21" y="86" width="134" height="152" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.2" />
      <text x="88" y="132" font-size="11" font-weight="700" text-anchor="middle" fill="var(--grey-11)">ApprovalMode</text>
      <text x="88" y="150" font-size={isEn ? 10.5 : 11} font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? '::Auto (Default)' : '::Auto (默认)'}</text>
      <text x="88" y="176" font-size="9.5" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'All tools auto-run' : '全部工具自动放行'}</text>
      <text x="88" y="194" font-size="9.5" text-anchor="middle" fill="var(--grey-8)">{isEn ? 'No confirm prompts' : '无交互确认弹窗'}</text>

      <rect x="21" y="252" width="134" height="152" fill="var(--grey-2)" stroke="var(--link)" stroke-width="1.2" />
      <text x="88" y="294" font-size="11" font-weight="700" text-anchor="middle" fill="var(--link)">--approve</text>
      <text x="88" y="313" font-size="10.5" font-weight="700" text-anchor="middle" fill="var(--grey-11)">/approval ask</text>
      <text x="88" y="340" font-size="9.5" text-anchor="middle" fill="var(--grey-9)">{isEn ? 'Gates mutating tools' : '拦截非只读工具'}</text>
      <text x="88" y="357" font-size="9.5" text-anchor="middle" fill="var(--grey-8)">{isEn ? 'incl. bash / write' : '含 bash / write'}</text>
      <text x="88" y="374" font-size="9.5" text-anchor="middle" fill="var(--grey-8)">edit / codemode</text>
    </g>

    {/* 象限 1 (左上)：false × Auto —— 危险默认区 */}
    <g>
      <rect x="165" y="86" width="320" height="152" fill="var(--grey-2)" stroke="var(--status-outage)" stroke-width="1.4" stroke-dasharray="5 3" />
      <rect x="165" y="86" width="320" height="28" fill="var(--code-del-tint)" stroke="var(--status-outage)" stroke-width="1.3" />
      <rect x="165" y="86" width="320" height="28" fill="url(#sec-hatch-danger)" />
      <rect x="176" y="90" width="174" height="20" fill="var(--grey-2)" stroke="var(--status-outage)" stroke-width="0.9" />
      <text x="184" y="104" font-size={isEn ? 10 : 10.5} font-weight="700" fill="var(--callout-danger-ink)">{isEn ? '⚠ Unrestricted Default' : '⚠ 危险开箱区（全开放）'}</text>
      <text x="473" y="104" font-size="9.5" font-weight="700" text-anchor="end" fill="var(--callout-danger-ink)">DEFAULT</text>

      <text x="181" y="136" font-size={isEn ? 9.5 : 10} fill="var(--grey-11)">{isEn ? '• File tools can access paths outside workspace' : '• 文件工具可读写当前工作区之外的路径'}</text>
      <text x="181" y="157" font-size={isEn ? 9.5 : 10} fill="var(--grey-10)">{isEn ? '• bash / write / edit run without prompts' : '• bash / write / edit 无弹窗直接执行'}</text>
      <text x="181" y="178" font-size={isEn ? 9.5 : 10} fill="var(--grey-9)">{isEn ? '• Best for: fully trusted local scaffolding' : '• 适用：完全受信任的本地脚手架开发'}</text>
      <rect x="181" y="194" width="288" height="30" fill="var(--code-del-tint)" stroke="var(--status-outage)" stroke-width="0.9" />
      <text x="325" y="213" font-size="9.5" font-weight="700" text-anchor="middle" fill="var(--callout-danger-ink)">{isEn ? '✕ Avoid this default on untrusted repos' : '✕ 陌生仓库禁止使用此默认组合'}</text>

      <rect x="163" y="84" width="4" height="4" fill="var(--status-outage)" />
    </g>

    {/* 象限 2 (右上)：true × Auto —— 路径伪沙箱 */}
    <g>
      <rect x="499" y="86" width="320" height="152" fill="var(--grey-2)" stroke="var(--status-degraded)" stroke-width="1.4" />
      <rect x="499" y="86" width="320" height="28" fill="var(--grey-3)" stroke="var(--status-degraded)" stroke-width="1.4" />
      <rect x="499" y="86" width="320" height="28" fill="url(#sec-hatch-warn)" />
      <rect x="510" y="90" width="186" height="20" fill="var(--grey-2)" stroke="var(--status-degraded)" stroke-width="0.9" />
      <text x="518" y="104" font-size={isEn ? 9.8 : 10.5} font-weight="700" fill="var(--callout-caution-ink)">{isEn ? '! Partial Scope (Shell Gap)' : '! 半受限警惕区 (Shell 盲区)'}</text>
      <text x="807" y="104" font-size="9.5" font-weight="700" text-anchor="end" fill="var(--callout-caution-ink)">PARTIAL</text>

      <text x="515" y="136" font-size={isEn ? 9 : 9.5} fill="var(--callout-tip-ink)">{isEn ? '✓ File tools (read/write/edit/grep/find) scoped' : '✓ 文件工具 (read/write/edit/grep/find) 锁死'}</text>
      <text x="515" y="157" font-size="9.5" font-weight="600" fill="var(--callout-danger-ink)">{isEn ? '⚠ bash commands bypass restrictToWorkspace' : '⚠ bash 内部命令不受 restrictToWorkspace 限制'}</text>
      <text x="515" y="178" font-size={isEn ? 9.5 : 10} fill="var(--grey-9)">{isEn ? '• Shell can reach outside via abs path or ../' : '• 命令仍可通过绝对路径或 ../ 触达区外'}</text>
      <rect x="515" y="194" width="288" height="30" fill="var(--grey-3)" stroke="var(--status-degraded)" stroke-width="0.9" />
      <text x="659" y="213" font-size={isEn ? 9 : 9.5} font-weight="600" text-anchor="middle" fill="var(--callout-caution-ink)">{isEn ? 'Pair with --approve or excludeTools: ["bash"]' : '需搭配 --approve 或 excludeTools: ["bash"]'}</text>
    </g>

    {/* 象限 3 (左下)：false × Ask —— 人工把关跨区 */}
    <g>
      <rect x="165" y="252" width="320" height="152" fill="var(--grey-2)" stroke="var(--link)" stroke-width="1.35" />
      <rect x="165" y="252" width="320" height="28" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1.35" />
      <text x="177" y="270" font-size={isEn ? 10 : 10.5} font-weight="700" fill="var(--grey-11)">{isEn ? 'Supervised Cross-Workspace' : '人工审计跨区模式'}</text>
      <text x="473" y="270" font-size="9.5" font-weight="700" text-anchor="end" fill="var(--link)">SUPERVISED</text>

      <text x="181" y="302" font-size={isEn ? 9.5 : 10} fill="var(--grey-11)">{isEn ? '✓ read / grep / find run silently (read-only)' : '✓ read / grep / find 只读工具静默免审'}</text>
      <text x="181" y="323" font-size={isEn ? 9.5 : 10} fill="var(--grey-10)">{isEn ? '✓ Writes, bash & codemode require approval' : '✓ 写操作与 bash / codemode 弹窗审批'}</text>
      <text x="181" y="344" font-size={isEn ? 9.5 : 10} fill="var(--grey-9)">{isEn ? '• Allows supervised multi-repo workflows' : '• 允许受控的跨工作区引用与多仓协同'}</text>
      <rect x="181" y="360" width="288" height="30" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="0.9" />
      <text x="325" y="379" font-size="9.5" font-weight="600" text-anchor="middle" fill="var(--link)">{isEn ? 'mizar --approve (confirm every write & cmd)' : 'mizar --approve（人工确认每步写入与命令）'}</text>
    </g>

    {/* 象限 4 (右下)：true × Ask —— 生产推荐防线 */}
    <g>
      <rect x="499" y="252" width="320" height="152" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.8" />
      <rect x="504" y="257" width="310" height="142" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1" />
      <rect x="499" y="252" width="320" height="28" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.6" />
      <rect x="499" y="252" width="320" height="28" fill="url(#sec-hatch-safe)" />
      <rect x="510" y="256" width="174" height="20" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1" />
      <text x="518" y="270" font-size={isEn ? 10 : 10.5} font-weight="700" fill="var(--callout-tip-ink)">{isEn ? '✓ Recommended Dual Lock' : '✓ 生产推荐防线（双锁）'}</text>
      <text x="807" y="270" font-size="9.5" font-weight="700" text-anchor="end" fill="var(--callout-tip-ink)">RECOMMENDED</text>

      <text x="515" y="302" font-size={isEn ? 9.5 : 10} font-weight="600" fill="var(--grey-11)">{isEn ? '✓ Defense-in-depth: scoped files + approvals' : '✓ 纵深防御：路径锁工作区 + 非只读全审批'}</text>
      <text x="515" y="323" font-size={isEn ? 9.5 : 10} fill="var(--grey-10)">{isEn ? '✓ Blocks bash escapes & accidental overwrites' : '✓ 彻底拦截 bash 越界与意外覆写风险'}</text>
      <text x="515" y="344" font-size={isEn ? 9.5 : 10} fill="var(--grey-9)">{isEn ? '• Stack excludeTools: ["mcp__*__drop_*"]' : '• 可叠加 excludeTools: ["mcp__*__drop_*"]'}</text>
      <rect x="515" y="360" width="288" height="30" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.1" />
      <text x="659" y="379" font-size="9" font-weight="700" text-anchor="middle" fill="var(--callout-tip-ink)">{isEn ? 'mizar --approve -C <repo> (+ --read-only audit)' : 'mizar --approve -C <repo> (仅审计加 --read-only)'}</text>

      <rect x="497" y="250" width="4" height="4" fill="var(--status-ok)" />
      <rect x="817" y="250" width="4" height="4" fill="var(--status-ok)" />
      <rect x="497" y="402" width="4" height="4" fill="var(--status-ok)" />
      <rect x="817" y="402" width="4" height="4" fill="var(--status-ok)" />
    </g>

    {/* 底部规则补充条 */}
    <g>
      <rect x="21" y="418" width="464" height="56" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.1" />
      <text x="35" y="438" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? 'Interactive Approval Actions (--approve / ask)' : '交互审批弹窗四动作（--approve / ask）'}</text>
      <text x="35" y="458" font-size={isEn ? 9.5 : 10} fill="var(--grey-9)">{isEn ? '[1] Allow once · [2] Always allow tool · [3] Deny · [4] Deny with reason' : '[1] 单次放行 · [2] 本工具始终放行 · [3] 拒绝 · [4] 附理由拒绝(引导模型改方案)'}</text>

      <rect x="499" y="418" width="320" height="56" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.1" />
      <text x="513" y="438" font-size="10.5" font-weight="700" fill="var(--grey-11)">{isEn ? '! / !! Local Bash Exception' : '! / !! 本地 Bash 例外边界'}</text>
      <text x="513" y="458" font-size={isEn ? 9.5 : 10} fill="var(--grey-9)">{isEn ? 'User-typed in input; bypasses tool approval' : '用户手动在输入框触发，跳过工具审批弹窗'}</text>
    </g>
  </svg>
</DiagramFrame>
