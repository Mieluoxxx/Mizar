---
import DiagramFrame from './DiagramFrame.astro';
import { getLocaleFromUrl, type Locale } from '../../lib/url';

interface Props {
  caption?: string;
  locale?: Locale;
}

const { caption } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const isEn = locale === 'en';
---

<DiagramFrame
  fig="FIG 03"
  title={isEn ? 'JSONL Session Forking, Compaction & Trajectory Export' : 'JSONL 会话分叉、压缩剪枝与轨迹观测'}
  caption={caption}
  locale={locale}
>
  <svg
    viewBox="0 0 840 500"
    width="840"
    height="500"
    role="img"
    aria-label={isEn
      ? 'Mizar session and trace views: tolerant JSONL persistence with SHA-256 blobs, compaction checkpoints and /tree forking on the left; Ctrl+T /trace WaveBand, three-lane Timeline, Hotspots and Inspector on the right'
      : 'Mizar 会话与轨迹双视图：左侧宽容 JSONL 持久化与 SHA-256 Blob 外置、Compaction 摘要检查点与 /tree 分叉探索；右侧 Ctrl+T /trace 的 WaveBand、三泳道 Timeline、Hotspots 与 Inspector 解剖图'}
  >
    <defs>
      <pattern id="sess-hatch-comp" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="5" stroke="var(--status-degraded)" stroke-width="0.9" stroke-opacity="0.24" />
      </pattern>
      <pattern id="sess-hatch-fork" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--status-ok)" stroke-width="1" stroke-opacity="0.20" />
      </pattern>
      <marker id="sess-arr-ink" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--grey-9)" />
      </marker>
      <marker id="sess-arr-ok" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M 1 1.5 L 8.5 5 L 1 8.5 Z" fill="var(--status-ok)" />
      </marker>
    </defs>

    {/* 左半区：JSONL 会话与 /tree 分叉 */}
    <g>
      <rect x="21" y="20" width="390" height="460" fill="var(--grey-2)" stroke="var(--border-strong)" stroke-width="1.35" />
      <rect x="21" y="20" width="390" height="26" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="1.35" />
      <text x="33" y="37" font-size={isEn ? 10.5 : 11} font-weight="700" fill="var(--grey-11)">{isEn ? 'JSONL Append Log & /tree Fork' : 'JSONL 只追加日志 & /tree 分叉'}</text>
      <text x="399" y="37" font-size="9.5" text-anchor="end" fill="var(--link)">mizar-session</text>

      {/* 持久化架构横条 */}
      <rect x="33" y="56" width="366" height="46" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="45" y="75" font-size="10" font-weight="700" fill="var(--grey-11)">mizar-session-jsonl (cwd-bucket · Blob · Lazy)</text>
      <text x="45" y="92" font-size={isEn ? 8.3 : 8.8} fill="var(--grey-9)">{isEn ? 'Single-Writer · non-silent errors · 0 version reject' : 'Single-Writer 线程 · 错必上报 · 不以版本号拒开'}</text>

      {/* 主干时间线 */}
      <line x1="50" y1="120" x2="50" y2="404" stroke="var(--border-strong)" stroke-width="1.6" />

      {/* Turn 1: #1 USER */}
      <rect x="46" y="128" width="8" height="8" fill="var(--link)" />
      <line x1="54" y1="132" x2="66" y2="132" stroke="var(--link)" stroke-width="1.2" />
      <rect x="66" y="114" width="164" height="36" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="76" y="130" font-size="10" font-weight="700" fill="var(--grey-11)">#1 USER (Turn 1)</text>
      <text x="76" y="144" font-size="9" fill="var(--grey-8)">{isEn ? '"Debug config merge"' : '"排查 config 合并逻辑"'}</text>

      {/* #2 ASST + TOOL */}
      <rect x="46" y="176" width="8" height="8" fill="var(--grey-9)" />
      <line x1="54" y1="180" x2="66" y2="180" stroke="var(--border-strong)" stroke-width="1.2" />
      <rect x="66" y="160" width="164" height="40" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="76" y="177" font-size="10" font-weight="700" fill="var(--grey-11)">#2 ASST + TOOL</text>
      <text x="76" y="192" font-size={isEn ? 8.5 : 8.8} fill="var(--grey-8)">{isEn ? 'read · edit · BASH!!(local)' : 'read · edit · BASH!!(仅本地)'}</text>

      {/* 分叉分支线（从 #2 分叉出新会话） */}
      <path d="M 230 180 H 242 V 222 H 251" fill="none" stroke="var(--status-ok)" stroke-width="1.4" marker-end="url(#sess-arr-ok)" />
      <rect x="254" y="126" width="145" height="172" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1.3" />
      <rect x="254" y="126" width="145" height="24" fill="url(#sess-hatch-fork)" stroke="var(--status-ok)" stroke-width="1.3" />
      <rect x="260" y="129" width="133" height="18" fill="var(--grey-2)" />
      <text x="326" y="142" font-size={isEn ? 9.5 : 10} font-weight="700" text-anchor="middle" fill="var(--callout-tip-ink)">{isEn ? '/tree Fork Session' : '/tree 分叉新会话'}</text>

      <text x="264" y="169" font-size={isEn ? 8.8 : 9.2} font-weight="600" fill="var(--grey-11)">fork(id, up_to_seq=#2)</text>
      <text x="264" y="186" font-size={isEn ? 8.3 : 8.6} fill="var(--grey-9)">{isEn ? '• Atomic create (no overwrite)' : '• 原子建新 (拒重名与覆盖)'}</text>
      <text x="264" y="202" font-size={isEn ? 8.8 : 9} fill="var(--grey-9)">• parent_id + fork_seq</text>
      <text x="264" y="218" font-size={isEn ? 8.5 : 9} fill="var(--grey-9)">{isEn ? '• Auto-heal orphan calls' : '• 悬挂工具调用自动自愈'}</text>
      <rect x="264" y="232" width="125" height="54" fill="var(--grey-2)" stroke="var(--status-ok)" stroke-width="1" />
      <text x="273" y="249" font-size={isEn ? 9 : 9.5} font-weight="700" fill="var(--callout-tip-ink)">{isEn ? "#3' USER (Branch B)" : "#3' USER (分支 B)"}</text>
      <text x="273" y="265" font-size="8.5" fill="var(--grey-9)">{isEn ? 'Try edits safely' : '无损探索不同修改方案'}</text>
      <text x="273" y="279" font-size="8.5" fill="var(--grey-8)">{isEn ? 'Mainline untouched' : '主干历史保持纯净不变'}</text>

      {/* #4 Compaction 检查点 */}
      <rect x="46" y="242" width="8" height="8" fill="var(--status-degraded)" />
      <line x1="54" y1="246" x2="66" y2="246" stroke="var(--status-degraded)" stroke-width="1.3" />
      <rect x="66" y="214" width="164" height="68" fill="var(--grey-3)" stroke="var(--status-degraded)" stroke-width="1.2" />
      <rect x="66" y="214" width="164" height="68" fill="url(#sess-hatch-comp)" />
      <rect x="72" y="220" width="152" height="56" fill="var(--grey-2)" opacity="0.95" />
      <text x="80" y="236" font-size="9.2" font-weight="700" fill="var(--callout-caution-ink)">{isEn ? '#3 B-5 COMPACT + PRUNE' : '#3 B-5 压缩 & 尾部剪枝'}</text>
      <text x="80" y="252" font-size={isEn ? 7.8 : 8.3} fill="var(--grey-10)">{isEn ? 'Hot-cache · 8k tail · supersede' : '热缓存保护 · 8k 尾 · 重读剪枝'}</text>
      <text x="80" y="267" font-size={isEn ? 7.8 : 8.3} fill="var(--grey-8)">{isEn ? 'B-5 Guard · FileGuardTracker' : 'B-5 护栏 · FileGuard 防误写'}</text>

      {/* #4 USER (Turn 2) */}
      <rect x="46" y="312" width="8" height="8" fill="var(--link)" />
      <line x1="54" y1="316" x2="66" y2="316" stroke="var(--link)" stroke-width="1.2" />
      <rect x="66" y="296" width="164" height="40" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1" />
      <text x="76" y="313" font-size="10" font-weight="700" fill="var(--grey-11)">#4 USER (Turn 2)</text>
      <text x="76" y="328" font-size="9" fill="var(--grey-9)">{isEn ? 'Continue from summary' : '基于摘要继续当前会话'}</text>

      {/* #5 ASST */}
      <rect x="46" y="368" width="8" height="8" fill="var(--grey-9)" />
      <line x1="54" y1="372" x2="66" y2="372" stroke="var(--border-strong)" stroke-width="1.2" />
      <rect x="66" y="352" width="333" height="44" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="76" y="370" font-size="10" font-weight="700" fill="var(--grey-11)">{isEn ? '#5 ASST · derive_messages() Projection' : '#5 ASST · derive_messages() 窗口投影'}</text>
      <text x="76" y="387" font-size="9" fill="var(--grey-8)">{isEn ? 'Skips LogOnly trace events & !! local cmds' : '自动跳过 LogOnly 轨迹事件与 !! 本地命令'}</text>

      {/* 底部恢复条 */}
      <rect x="33" y="410" width="366" height="56" fill="var(--grey-3)" stroke="var(--border)" stroke-width="1" />
      <text x="45" y="431" font-size="10" font-weight="700" fill="var(--grey-11)">{isEn ? 'Session Resume & Crash Recovery' : '断点续聊 & 崩溃自愈'}</text>
      <text x="45" y="449" font-size={isEn ? 9 : 9.5} fill="var(--grey-9)">{isEn ? '--continue / --resume <id> · prints cmd on exit' : '--continue / --resume <id> · 退出自动打印恢复命令'}</text>

      <rect x="19" y="18" width="4" height="4" fill="var(--grey-1)" stroke="var(--grey-7)" stroke-width="1" />
      <rect x="409" y="478" width="4" height="4" fill="var(--grey-1)" stroke="var(--grey-7)" stroke-width="1" />
    </g>

    {/* 右半区：Ctrl+T / /trace 全屏三泳道解剖 */}
    <g>
      <rect x="429" y="20" width="390" height="460" fill="var(--grey-2)" stroke="var(--link)" stroke-width="1.4" />
      <rect x="429" y="20" width="390" height="26" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1.4" />
      <text x="441" y="37" font-size={isEn ? 10.5 : 11} font-weight="700" fill="var(--grey-11)">{isEn ? 'Ctrl+T / /trace 3-Lane Profiler' : 'Ctrl+T / /trace 三泳道轨迹解剖'}</text>
      <text x="807" y="37" font-size="9.5" font-weight="700" text-anchor="end" fill="var(--link)">TRAJECTORY</text>

      {/* 顶部页签栏 */}
      <rect x="441" y="56" width="366" height="26" fill="var(--grey-3)" stroke="var(--border)" stroke-width="1" />
      <text x="453" y="73" font-size="10" font-weight="700" fill="var(--link)">Timeline</text>
      <line x1="451" y1="80" x2="505" y2="80" stroke="var(--link)" stroke-width="2" />
      <text x="521" y="73" font-size="10" fill="var(--grey-9)">Hotspots</text>
      <text x="795" y="73" font-size={isEn ? 9 : 9.5} text-anchor="end" fill="var(--grey-8)">{isEn ? '[Axis: Duration / Seq / Actual]' : '[轴: Duration / Seq / Actual]'}</text>

      {/* 1. WaveBand 全会话波形带 */}
      <rect x="441" y="90" width="366" height="72" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="451" y="106" font-size="9.5" font-weight="700" fill="var(--grey-10)">{isEn ? '① WaveBand Overview (Click bar to jump)' : '① WaveBand 全会话波形带 (点击列跳转)'}</text>

      {/* 波形脉冲柱 */}
      <rect x="453" y="122" width="18" height="10" fill="var(--link)" />
      <rect x="475" y="116" width="34" height="16" fill="var(--link)" />
      <rect x="515" y="138" width="24" height="10" fill="var(--status-ok)" />
      <rect x="543" y="134" width="28" height="14" fill="var(--status-ok)" />
      <rect x="577" y="114" width="42" height="18" fill="var(--link)" />
      <rect x="625" y="132" width="30" height="16" fill="var(--status-ok)" />
      <rect x="659" y="136" width="14" height="12" fill="var(--status-outage)" />
      <rect x="679" y="116" width="38" height="16" fill="var(--link)" />
      <rect x="723" y="136" width="26" height="12" fill="var(--status-ok)" />
      <rect x="755" y="120" width="36" height="12" fill="var(--link)" />

      {/* 波形光标 */}
      <line x1="636" y1="112" x2="636" y2="154" stroke="var(--grey-11)" stroke-width="1.3" stroke-dasharray="2 2" />
      <polygon points="632,111 640,111 636,116" fill="var(--grey-11)" />

      {/* 2. Timeline 三泳道 */}
      <rect x="441" y="172" width="366" height="122" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="451" y="189" font-size="9.5" font-weight="700" fill="var(--grey-10)">{isEn ? '② Timeline 3-Lane Ledger (Lane 0 / 1 / 2)' : '② Timeline 三泳道账本 (Lane 0 / 1 / 2)'}</text>

      {/* Lane 0 */}
      <text x="451" y="213" font-size="9" font-weight="600" fill="var(--grey-8)">{isEn ? 'L0 In/Alert' : 'L0 输入/告警'}</text>
      <line x1="522" y1="209" x2="795" y2="209" stroke="var(--border)" stroke-width="1" />
      <rect x="524" y="201" width="46" height="16" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="0.9" />
      <text x="547" y="213" font-size="8.5" text-anchor="middle" fill="var(--grey-11)">USER</text>
      <rect x="576" y="201" width="38" height="16" fill="var(--grey-3)" stroke="var(--border-strong)" stroke-width="0.9" />
      <text x="595" y="213" font-size="8.5" text-anchor="middle" fill="var(--grey-10)">CTX</text>
      <rect x="698" y="201" width="84" height="16" fill="var(--code-del-tint)" stroke="var(--status-degraded)" stroke-width="0.9" />
      <text x="740" y="213" font-size="8.5" text-anchor="middle" fill="var(--callout-caution-ink)">⚠ RepeatGuard</text>

      {/* Lane 1 */}
      <text x="451" y="244" font-size="9" font-weight="600" fill="var(--link)">{isEn ? 'L1 LLM Turn' : 'L1 模型响应'}</text>
      <line x1="522" y1="240" x2="795" y2="240" stroke="var(--border)" stroke-width="1" />
      <rect x="562" y="231" width="28" height="18" fill="var(--grey-4)" stroke="var(--link)" stroke-width="1" />
      <text x="576" y="243" font-size="8" text-anchor="middle" fill="var(--grey-10)">TTFT</text>
      <rect x="590" y="231" width="66" height="18" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1" />
      <text x="623" y="243" font-size="8.5" font-weight="600" text-anchor="middle" fill="var(--link)">Decode 1.1s</text>
      <rect x="720" y="231" width="64" height="18" fill="var(--code-mark-tint)" stroke="var(--link)" stroke-width="1" />
      <text x="752" y="243" font-size="8.5" text-anchor="middle" fill="var(--link)">LLM T2</text>

      {/* Lane 2 */}
      <text x="451" y="275" font-size="9" font-weight="600" fill="var(--callout-tip-ink)">{isEn ? 'L2 Tool Run' : 'L2 工具执行'}</text>
      <line x1="522" y1="271" x2="795" y2="271" stroke="var(--border)" stroke-width="1" />
      <rect x="626" y="262" width="44" height="18" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1" />
      <text x="648" y="274" font-size="8.5" text-anchor="middle" fill="var(--callout-tip-ink)">read</text>
      <rect x="676" y="262" width="54" height="18" fill="var(--code-add-tint)" stroke="var(--status-ok)" stroke-width="1" />
      <text x="703" y="274" font-size="8.5" text-anchor="middle" fill="var(--callout-tip-ink)">bash</text>
      <rect x="736" y="262" width="38" height="18" fill="var(--code-del-tint)" stroke="var(--status-outage)" stroke-width="1" />
      <text x="755" y="274" font-size="8.5" text-anchor="middle" fill="var(--callout-danger-ink)">err</text>

      {/* Hotspots 热点排行预览 */}
      <rect x="441" y="302" width="366" height="72" fill="var(--grey-1)" stroke="var(--border-strong)" stroke-width="1" />
      <text x="451" y="319" font-size="9.5" font-weight="700" fill="var(--grey-10)">{isEn ? '③ Hotspots Latency Ranking (Tab)' : '③ Hotspots 耗时热点排行 (Tab 切换)'}</text>
      <text x="451" y="338" font-size="9.5" font-weight="700" fill="var(--link)">▸ bash           4 calls    820ms</text>
      <rect x="698" y="330" width="94" height="8" fill="var(--link)" />
      <text x="451" y="356" font-size="9.5" fill="var(--grey-9)">  grep           6 calls     74ms   err:1</text>
      <rect x="698" y="348" width="28" height="8" fill="var(--status-outage)" />

      {/* 底部 Inspector */}
      <rect x="441" y="384" width="366" height="82" fill="var(--grey-3)" stroke="var(--link)" stroke-width="1.1" />
      <text x="453" y="403" font-size="10" font-weight="700" fill="var(--grey-11)">{isEn ? '④ Step Inspector & /export' : '④ Inspector 单步检查器 & /export'}</text>
      <text x="453" y="421" font-size="9.5" fill="var(--grey-10)">{isEn ? 'TTFT: 280ms · Total: 1,380ms · ↑12.4k ↓840 tokens' : 'TTFT: 280ms · 耗时: 1,380ms · ↑12.4k ↓840 tokens'}</text>
      <text x="453" y="438" font-size="9" fill="var(--grey-9)">{isEn ? 'Full tool args / result preview / RepeatGuard alerts' : '展示完整工具参数 / 返回预览 / RepeatToolGuard 告警'}</text>
      <text x="453" y="454" font-size="8.8" fill="var(--link)">/export → .jsonl · exec --trace-out → TrajectoryExport</text>

      <rect x="427" y="18" width="4" height="4" fill="var(--link)" />
      <rect x="817" y="478" width="4" height="4" fill="var(--link)" />
    </g>
  </svg>
</DiagramFrame>
