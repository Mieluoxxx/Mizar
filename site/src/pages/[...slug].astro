---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import { cleanMdxToMarkdown } from '../lib/markdown';
import { splitLocaleContentId } from '../lib/url';
import DiagramEmbed from '../components/DiagramEmbed.astro';
import CodeTabs from '../components/mdx/CodeTabs.astro';
import Callout from '../components/mdx/Callout.astro';
import Steps from '../components/mdx/Steps.astro';
import CardGroup from '../components/mdx/CardGroup.astro';
import DocCard from '../components/mdx/DocCard.astro';
import MdPre from '../components/mdx/MdPre.astro';
import MdTable from '../components/mdx/MdTable.astro';
import MdH2 from '../components/mdx/MdH2.astro';
import MdH3 from '../components/mdx/MdH3.astro';
import MdH4 from '../components/mdx/MdH4.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries
    .map((entry) => {
      const { locale, slug } = splitLocaleContentId(entry.id);
      return { entry, locale, slug };
    })
    .filter(({ slug }) => slug !== 'intro')
    .map(({ entry, locale, slug }) => ({
      params: { slug: locale === 'en' ? `en/${slug}` : slug },
      props: { entry, locale, slug },
    }));
}

const { entry, locale, slug } = Astro.props;
const { Content, headings } = await render(entry);
const markdownSource = cleanMdxToMarkdown(
  entry.data.title,
  entry.body || '',
  locale,
);
const mdxComponents = {
  DiagramEmbed,
  CodeTabs,
  Callout,
  Steps,
  CardGroup,
  DocCard,
  pre: MdPre,
  table: MdTable,
  h2: MdH2,
  h3: MdH3,
  h4: MdH4,
};
---

<DocsLayout
  slug={slug}
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  markdownSource={markdownSource}
  filePath={entry.filePath}
>
  <Content components={mdxComponents} />
</DocsLayout>
